+"""Generic decision seam at its native callsites, in both master states.
+
+Real ``AIAgent.run_conversation`` against an in-process provider for the turn-context and
+work-executor entries; callsite-level calls for search results, pre-agent routing and approval
+triage. The plugin evaluator is replaced by a registered ``select_agent_step`` callback returning
+the evaluator's reading shape. Every text is synthetic. Off and every forced fallback must leave
+the provider payload byte-identical to the original.
+"""
+from __future__ import annotations
+
+import json
+import sys
+
+import pytest
+
+from agent import decision_seams, decision_sources
+from agent.decision_config import DEFAULT_EXECUTORS, Settings, merge_executors
+from tests.agent.test_decision_native import _bound, _chat, _Provider, _reading, _text, env  # noqa: F401
+
+
+class Evaluator:
+    """Answers every descriptor with ``picks[point]`` (index or bool); records each call."""
+
+    def __init__(self, picks):
+        self.picks, self.calls, self.fail = picks, [], False
+
+    def __call__(self, **kw):
+        self.calls.append(kw)
+        if self.fail:
+            raise RuntimeError("synthetic outage")
+        out = []
+        for r in kw["requests"]:
+            pick = True if r["point"] == "ask.decision_gate" else self.picks.get(r["point"])
+            out.append(_bound(_reading(recommendation=pick), r))
+        return out
+
+
+@pytest.fixture()
+def seam(env, monkeypatch):
