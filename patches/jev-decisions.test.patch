+    assert decision_sources.search_pick(agent, tool_name="web_search", args={"query": "q"}, result=RESULT,
+                                        tool_call_id="c2") == RESULT          # nothing kept: original
+    calls = iter([True, False])
+    evaluator.picks = type("P", (), {"get": lambda self, p: next(calls)})()
+    out = json.loads(decision_sources.search_pick(agent, tool_name="web_search", args={"query": "q"},
+                                                  result=RESULT, tool_call_id="c3"))
+    assert [i["url"] for i in out["data"]["web"]] == ["https://example.com/a"]
