+def test_executor_create_runs_the_configured_command_and_feeds_back(seam):
+    make_agent, evaluator, _ = seam
+    evaluator.picks["work.executor"] = 0            # options sorted: create, maintain
+    agent = make_agent(tools=("read_file", "terminal"),
+                       settings=_on(exclude=frozenset({"code.approach"}), executors=_executors("import sys; print('SYNTH-EXEC ' + str(len(sys.stdin.read())))")))
+    _Provider.requests, _Provider.queue = [], []
+    result = agent.run_conversation("build a synthetic thing", conversation_history=[], task_id="t")
+    assert "SYNTH-EXEC" in result["final_response"] and _chat(_Provider.requests) == [], seam_receipts(seam)
+    gate, choice = evaluator.calls[0]["requests"]
+    assert gate["for"] == "work.executor" and choice["point"] == "work.executor"
+
