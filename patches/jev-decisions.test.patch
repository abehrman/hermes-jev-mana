+def _plan_source(effects="read_only", tool="read_file", args=None, store=None):
+    def source(agent, turn):
+        if not turn.first:
+            return None
+        return dn.NativeStep(
+            kind="tool_plan", step_id="synthetic.workflow", revision=turn.turn_id, effects=effects,
+            state={"observation": "two synthetic files"},
+            options=[{"id": "a", "description": "Read the unrelated file",
+                      "calls": [{"tool": tool, "args": args or {"path": str(store / "a.txt")}}]},
+                     {"id": "b", "description": "Read the verified file",
+                      "calls": [{"tool": tool, "args": args or {"path": str(store / "b.txt")}}]}])
+    return source
+
+
+def test_tool_plan_runs_ordinary_tool_round_then_provider_keeps_its_own_ids(env, tmp_path):
+    make_agent, hook, db = env
+    (tmp_path / "a.txt").write_text("unrelated")
+    (tmp_path / "b.txt").write_text("verified-fixture")
+    agent = make_agent()
+    agent._native_step_sources = [_plan_source(store=tmp_path)]
+    _Provider.queue.append(_tool("call_provider_1", "read_file", {"path": str(tmp_path / "a.txt")}))
+    _Provider.queue.append(_text("done"))
+    result = agent.run_conversation("find the verified file", conversation_history=[], task_id="t")
+    assert result["final_response"] == "done"
+    chat = _chat(_Provider.requests)
+    assert len(chat) == 2                                 # native step took no provider call; provider drove the rest
+    msgs = db.get_messages_as_conversation("sess-native")
+    assert [m["role"] for m in msgs] == ["user", "assistant", "tool", "assistant", "tool", "assistant"]
+    native_call = msgs[1]["tool_calls"][0]
+    assert native_call["id"].startswith("call_") and native_call["id"] != "call_provider_1"
+    assert json.loads(native_call["function"]["arguments"]) == {"path": str(tmp_path / "b.txt")}
+    assert msgs[2]["tool_call_id"] == native_call["id"] and "verified-fixture" in msgs[2]["content"]
+    # The provider's own emitted identity is untouched on its turn and in the replay it received.
+    assert msgs[3]["tool_calls"][0]["id"] == "call_provider_1" and msgs[4]["tool_call_id"] == "call_provider_1"
+    second = chat[1]["messages"]
+    assert any(t.get("tool_call_id") == "call_provider_1" for t in second if t["role"] == "tool")
+    # Every tool call is answered exactly once and the native row precedes any provider output.
+    ids = [c["id"] for m in msgs if m.get("tool_calls") for c in m["tool_calls"]]
+    answered = [m["tool_call_id"] for m in msgs if m["role"] == "tool"]
+    assert ids == answered
+    assert hook.calls[0]["requests"][1]["candidate_source"] == "code_enum"
+    assert [r["outcome"] for r in hook.receipts if r.get("outcome")] == ["round_completed"]
+    # Replay is blocked: a second native attempt for the same turn step cannot execute again.
+    assert len(hook.calls) == 1
+
