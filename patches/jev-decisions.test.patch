+def test_recommendation_is_not_authorization(env, tmp_path):
+    """A tool outside the read-only set needs the source to opt into ordinary policy, and even then
+    the ordinary pre_tool_call veto still applies in the unmodified tool round."""
+    make_agent, hook, db = env
+    agent = make_agent(tools=("read_file", "terminal"))
+    agent.tools.append({"type": "function", "function": {"name": "terminal", "parameters": {
+        "type": "object", "properties": {"command": {"type": "string"}}, "required": ["command"]}}})
+    agent._native_step_sources = [_plan_source(effects="ordinary_policy", tool="terminal",
+                                               args={"command": "echo synthetic"}, store=tmp_path)]
+    from hermes_cli.plugins import get_plugin_manager
+    manager = get_plugin_manager()
+    saved = list(manager._hooks.get("pre_tool_call", []))
+    manager._hooks["pre_tool_call"] = [lambda **kw: {"action": "block", "message": "blocked by synthetic policy"}]
+    _Provider.queue.append(_text("provider after block"))
+    try:
+        agent.run_conversation("go", conversation_history=[], task_id="t")
+    finally:
+        manager._hooks["pre_tool_call"] = saved
+    tool_rows = [m for m in db.get_messages_as_conversation("sess-native") if m["role"] == "tool"]
+    assert len(tool_rows) == 1 and "blocked by synthetic policy" in tool_rows[0]["content"]
+    assert '"exit_code"' not in tool_rows[0]["content"]       # the command never ran
