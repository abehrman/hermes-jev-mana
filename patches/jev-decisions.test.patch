+from types import SimpleNamespace
+
+import pytest
+
+from agent.decision_config import for_agent, from_config, load_settings
+
+
+def config(**values):
+    return {"plugins": {"enabled": ["jev-mana"]}, "jev": values}
+
+
+@pytest.mark.parametrize("values", [{}, {"decisions": "off"}, {"decisions": "shadow"},
+                                    {"decisions": True}])
+def test_original_is_default(values):
+    assert not from_config(config(**values)).enabled
+
+
+def test_master_switch_and_overrides():
+    settings = from_config(config(decisions="on"), {"exclude": ["gui.step"], "margin": 0.2})
+    assert settings.includes("tool.plan")
+    assert not settings.includes("gui.step")
+    assert settings.margin == 0.2
+
+
+@pytest.mark.parametrize("plugins", [{}, {"enabled": []}, {"enabled": ["jev-mana"],
+    "disabled": ["jev-mana"]}, {"enabled": ["jev-mana"],
+    "entries": {"jev-mana": {"enabled": False}}}])
+def test_disabled_plugin_is_original(plugins):
+    assert not from_config({"plugins": plugins, "jev": {"decisions": "on"}}).enabled
+
+
+@pytest.mark.parametrize("margin", [True, -0.1, 0, float("nan"), float("inf"), "0.2", 2])
+def test_invalid_margin_is_original(margin):
+    assert not from_config(config(decisions="on"), {"margin": margin}).enabled
+
+
+def test_loads_normal_config_with_defaults(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr("hermes_cli.profiles._get_default_hermes_home", lambda: tmp_path)
+    (tmp_path / "config.yaml").write_text("plugins:\n  enabled: [jev-mana]\njev:\n  decisions: 'on'\n")
+    settings = load_settings()
+    assert settings.enabled
+    assert settings.margin == 0.15
+
+
+def test_session_settings_frozen(monkeypatch):
+    calls = []
+    monkeypatch.setattr("agent.decision_config.load_settings", lambda: calls.append(1) or from_config(config()))
+    agent = SimpleNamespace()
+    assert for_agent(agent) is for_agent(agent)
+    assert calls == [1]
+
+
+@pytest.mark.parametrize("profile,expected", [
+    ({}, {"exclude": ["gui.step"], "margin": 0.2}),
+    ({"exclude": ["tool.plan"]}, {"exclude": ["gui.step", "tool.plan"], "margin": 0.2}),
+    ({"include": ["gui.step"]}, {"exclude": [], "margin": 0.2}),
+    ({"use_global": False}, {"exclude": []}),
+])
+def test_global_inheritance(profile, expected):
+    from agent.decision_config import merge_tuning
+    assert merge_tuning({"exclude": ["gui.step"], "margin": 0.2}, profile) == expected
+
+
+def test_unknown_ids_warn_without_exporting_them(caplog):
+    from agent.decision_config import merge_tuning
+    assert merge_tuning({}, {"exclude": ["unknown", "skill.pick"]}) == {"exclude": ["skill.pick"]}
+    assert "Unknown Jev tuning point" in caplog.text
+    assert "unknown" not in caplog.text
+
+
+def test_global_only_fields_ignored(caplog):
+    from agent.decision_config import merge_tuning
+    assert merge_tuning({"use_global": False, "include": ["gui.step"], "exclude": ["gui.step"]}, {}) == {"exclude": ["gui.step"]}
+    assert "ignores use_global and include" in caplog.text
+
+
+@pytest.mark.parametrize("global_text,profile_text,excluded,margin", [
+    ("exclude: [gui.step]\nmargin: 0.2\n", None, {"gui.step"}, 0.2),
+    ("exclude: [gui.step]\n", "exclude: [tool.plan]\n", {"gui.step", "tool.plan"}, 0.15),
+    ("exclude: [gui.step]\n", "include: [gui.step]\n", set(), 0.15),
+    ("exclude: [gui.step]\nmargin: 0.2\n", "use_global: false\n", set(), 0.15),
+    (None, None, set(), 0.15),
+])
+def test_effective_profile_files(tmp_path, monkeypatch, global_text, profile_text, excluded, margin):
+    root = tmp_path / "global"
+    home = root / "profiles" / "test"
+    home.mkdir(parents=True)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr("hermes_cli.profiles._get_default_hermes_home", lambda: root)
+    (home / "config.yaml").write_text("plugins:\n  enabled: [jev-mana]\njev:\n  decisions: 'on'\n")
+    if global_text is not None:
+        (root / "jev_config.yaml").write_text(global_text)
+    if profile_text is not None:
+        (home / "jev_config.yaml").write_text(profile_text)
+    settings = load_settings()
+    assert settings.enabled
+    assert settings.exclude == excluded
+    assert settings.margin == margin
+
+
+def test_executor_defaults_and_profile_field_override():
+    from agent.decision_config import merge_tuning
+    tuning = merge_tuning({"executors": {"create": {"type": "codex", "mode": "print", "model": "pinned"}}},
+                          {"executors": {"create": {"effort": "high"}}})
+    settings = from_config(config(decisions="on"), tuning)
+    assert settings.executors["create"] == {"type": "codex", "mode": "print", "model": "pinned", "effort": "high", "workdir_policy": "worktree"}
+    assert settings.executors["maintain"]["type"] == "hermes"
+    assert from_config(config(decisions="on")).includes("work.executor")
+
+
+def test_standalone_executor_mapping_does_not_inherit_global():
+    from agent.decision_config import merge_tuning
+    tuning = merge_tuning({"executors": {"create": {"type": "codex"}}}, {"use_global": False, "executors": {"create": {"effort": "low"}}})
+    settings = from_config(config(decisions="on"), tuning)
+    assert settings.executors["create"]["type"] == "claude-code"
+    assert settings.executors["create"]["effort"] == "low"
+
+
+def test_invalid_executor_mapping_falls_original():
+    settings = from_config(config(decisions="on"), {"executors": {"create": {"type": "unknown"}}})
+    assert not settings.enabled
