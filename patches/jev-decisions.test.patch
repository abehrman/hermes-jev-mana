+def test_executor_maintain_and_unready_keep_the_original_hermes_turn(seam):
+    make_agent, evaluator, _ = seam
+    evaluator.picks["work.executor"] = 1            # maintain -> original Hermes executor
+    agent = make_agent(tools=("read_file", "terminal"), settings=_on(exclude=frozenset({"code.approach"}), executors=_executors("print('x')")))
+    _Provider.requests, _Provider.queue = [], [_text("PROVIDER")]
+    assert agent.run_conversation("fix it", conversation_history=[], task_id="t")["final_response"] == "PROVIDER"
+    evaluator.calls.clear()
+    agent = make_agent(tools=("read_file",), settings=_on(exclude=frozenset({"code.approach"}), executors=_executors("print('x')")))  # no terminal permission
+    _Provider.queue = [_text("PROVIDER")]
+    assert agent.run_conversation("fix it", conversation_history=[], task_id="t")["final_response"] == "PROVIDER"
+    assert evaluator.calls == []
