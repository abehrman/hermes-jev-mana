+    tool, args = "read_file", {"path": "x"}
+    if fault == "unknown_tool":
+        tool = "nope"
+    if fault == "write_tool_read_only":
+        tool, args = "terminal", {"command": "true"}
+    if fault == "bad_arg":
+        args = {"path": 5}
+    if fault == "extra_arg":
+        args = {"path": "x", "execute": True}
+    agent._native_step_sources = [_plan_source(tool=tool, args=args, store=tmp_path)]
+    _Provider.queue.append(_text("provider answer"))
