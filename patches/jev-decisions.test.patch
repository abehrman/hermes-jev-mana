+def _skills(monkeypatch, loaded):
+    monkeypatch.setattr(decision_sources, "_skill_rows", lambda: [
+        {"load_name": "synthetic-alpha", "description": "Synthetic alpha procedure"},
+        {"load_name": "synthetic-beta", "description": "Synthetic beta procedure"}])
+    monkeypatch.setattr(decision_sources, "_load_skill", lambda name, task_id: loaded.append(name) or f"[SKILL {name}]")
+
+
+def _turn(make_agent, settings):
+    _Provider.requests, _Provider.queue = [], [_text("done")]
+    agent = make_agent(settings=settings)
+    agent.run_conversation("synthetic task", conversation_history=[], task_id="t")
+    return _user_rows(_Provider.requests)
+
