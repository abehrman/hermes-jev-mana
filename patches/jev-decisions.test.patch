+    evaluator.picks["context.pick"] = False
+    kept, _ = decision_sources.apply_turn_context(agent, user_text="q", ext_prefetch_cache=prefetch,
+                                                  plugin_user_context="", turn_id="turn-b")
+    assert kept == ""
+    evaluator.fail = True
+    kept, _ = decision_sources.apply_turn_context(agent, user_text="q", ext_prefetch_cache=prefetch,
+                                                  plugin_user_context="", turn_id="turn-c")
