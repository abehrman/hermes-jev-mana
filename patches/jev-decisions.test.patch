+"""hermes-jev-mana additions: master-value spelling, the admit_unlabeled opt-in and the stock-host admission rule."""
+from __future__ import annotations
+
+import pytest
+
+from agent import decision_config, decision_seams
+from agent.decision_config import Settings, from_config, merge_tuning
+
+
+def _cfg(decisions="on", **extra):
+    return {"plugins": {"enabled": [decision_config.PLUGIN]}, "jev": {"decisions": decisions, **extra}}
+
+
+@pytest.mark.parametrize("value,expected", [("on", True), (True, True), ("ON", True), ("off", False), (False, False),
+                                            (None, False), ("true", False), (1, False), ("", False)])
+def test_master_value_spellings(value, expected):
+    assert from_config(_cfg(value)).enabled is expected
+
+
+def test_plugin_name_is_jev_mana_and_disabled_plugin_is_off():
+    assert decision_config.PLUGIN == "jev-mana"
+    cfg = _cfg()
+    cfg["plugins"]["disabled"] = ["jev-mana"]
+    assert from_config(cfg).enabled is False
+    assert from_config({"plugins": {"enabled": ["hermes-jev"]}, "jev": {"decisions": "on"}}).enabled is False
+
+
+def test_all_twelve_points_are_registered_including_work_executor():
+    assert len(decision_config.POINTS) == 12 and "work.executor" in decision_config.POINTS
+
+
+def test_admit_unlabeled_defaults_false_and_validates():
+    assert from_config(_cfg(), {}).admit_unlabeled is False
+    assert from_config(_cfg(), {"admit_unlabeled": True}).admit_unlabeled is True
+    assert from_config(_cfg(), {"admit_unlabeled": "yes"}).enabled is False      # invalid tuning: original Hermes
+
+
+def test_admit_unlabeled_is_a_profile_scalar_and_global_only_default_applies():
+    merged = merge_tuning({"admit_unlabeled": True}, {})
+    assert merged["admit_unlabeled"] is True
+    assert merge_tuning({"admit_unlabeled": True}, {"admit_unlabeled": False})["admit_unlabeled"] is False
+    assert "admit_unlabeled" not in merge_tuning({"admit_unlabeled": True}, {"use_global": False})
+
+
+class _Agent:
+    _persist_disabled = False
+
+
+def _stock(monkeypatch, settings):
+    """A host with no source-label authority (agent.jev_source absent)."""
+    import sys
+    monkeypatch.setitem(sys.modules, "agent.jev_source", None)         # ImportError on `from agent import jev_source`
+    monkeypatch.setattr(decision_seams, "settings_for", lambda agent=None: settings)
+
+
+def test_stock_host_denies_unlabeled_content_by_default(monkeypatch):
+    _stock(monkeypatch, Settings(enabled=True))
+    assert decision_seams.remote_admitted(_Agent()) is False
+
+
+def test_stock_host_opt_in_admits_but_agent_privacy_flags_still_deny(monkeypatch):
+    _stock(monkeypatch, Settings(enabled=True, admit_unlabeled=True))
+    assert decision_seams.remote_admitted(_Agent()) is True
+    for flag in ("_persist_disabled", "_jev_local_only", "_jev_protected"):
+        agent = _Agent()
+        setattr(agent, flag, True)
+        assert decision_seams.remote_admitted(agent) is False
+    agent = _Agent()
+    agent._jev_privacy = "private"
+    assert decision_seams.remote_admitted(agent) is False
+
+
+def test_explicit_host_authority_beats_the_opt_in(monkeypatch):
+    _stock(monkeypatch, Settings(enabled=True, admit_unlabeled=True))
+    agent = _Agent()
+    agent._native_remote_admission = lambda: False
+    assert decision_seams.remote_admitted(agent) is False
