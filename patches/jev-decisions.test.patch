@@ -0,0 +1,444 @@
+"""Native pre-provider decision step, driven through the real conversation loop.
+
+A real ``AIAgent`` runs ``run_conversation`` against an in-process mock provider. The
+``select_agent_step`` callback is registered on the real plugin manager and returns readings in the
+jevkit ``Evaluator`` result shape (the jevkit evaluator itself lives in the portable package and is
+covered by its own tests). All text is synthetic.
+"""
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import tempfile
+import threading
+import time
+from http.server import BaseHTTPRequestHandler, HTTPServer
+from pathlib import Path
+
+import pytest
+
+from agent import decision_native as dn
+from agent.decision_config import Settings
+from run_agent import AIAgent  # native loop dependencies load before fixture I/O guards
+from agent.decision_consumer import Journal
+from hermes_state import SessionDB
+
+OPTIONS = [
+    {"id": "approve", "description": "Approve the synthetic change", "answer": "Approved: proceeding."},
+    {"id": "reject", "description": "Reject the synthetic change", "answer": "Rejected: stopping."},
+]
+
+
+class _Provider(BaseHTTPRequestHandler):
+    requests: list = []
+    queue: list = []
+
+    def do_POST(self):  # noqa: N802
+        body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))).decode())
+        type(self).requests.append(body)
+        resp = type(self).queue.pop(0) if type(self).queue else _text("PROVIDER")
+        msg = resp["choices"][0]["message"]
+        if body.get("stream") is True:
+            self.send_response(200)
+            self.send_header("Content-Type", "text/event-stream")
+            self.end_headers()
+            chunks = [{"id": "m", "choices": [{"index": 0, "delta": {"role": "assistant", "content": ""}, "finish_reason": None}]}]
+            if msg.get("content"):
+                chunks.append({"id": "m", "choices": [{"index": 0, "delta": {"content": msg["content"]}, "finish_reason": None}]})
+            for i, tc in enumerate(msg.get("tool_calls") or []):
+                chunks.append({"id": "m", "choices": [{"index": 0, "delta": {"tool_calls": [{
+                    "index": i, "id": tc["id"], "type": "function", "function": tc["function"]}]}, "finish_reason": None}]})
+            chunks.append({"id": "m", "choices": [{"index": 0, "delta": {}, "finish_reason": "tool_calls" if msg.get("tool_calls") else "stop"}]})
+            for chunk in chunks:
+                self.wfile.write(f"data: {json.dumps(chunk)}\n\n".encode())
+            self.wfile.write(b"data: [DONE]\n\n")
+            self.wfile.flush()
+        else:
+            data = json.dumps(resp).encode()
+            self.send_response(200)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(data)))
+            self.end_headers()
+            self.wfile.write(data)
+
+    def log_message(self, *a, **k):
+        pass
+
+
+def _text(text):
+    return {"id": "m", "choices": [{"index": 0, "message": {"role": "assistant", "content": text}, "finish_reason": "stop"}],
+            "usage": {"prompt_tokens": 10, "completion_tokens": 1, "total_tokens": 11}}
+
+
+def _tool(call_id, name, args):
+    return {"id": "m", "choices": [{"index": 0, "message": {"role": "assistant", "content": "", "tool_calls": [
+        {"id": call_id, "type": "function", "function": {"name": name, "arguments": json.dumps(args)}}]},
+        "finish_reason": "tool_calls"}], "usage": {"prompt_tokens": 10, "completion_tokens": 1, "total_tokens": 11}}
+
+
+def _reading(**over):
+    base = {"schema": "decision_receipt.v1", "evaluation": "jev", "adequate": True, "applied": None,
+            "recommendation": None, "margin": 0.7, "latency_ms": 5, "reason": "usable"}
+    return {**base, **over}
+
+
+def _bound(reading, request):
+    """What the jevkit Evaluator returns: the reading bound to its request's point and label."""
+    return {**reading, "point_id": request["point"], "candidate_source": request["candidate_source"]}
+
+
+class Hook:
+    """Registered ``select_agent_step`` / ``agent_decision_receipt`` callbacks."""
+
+    def __init__(self):
+        self.calls, self.receipts = [], []
+        self.gate = _reading(recommendation=True)
+        self.pick = 1
+        self.delay = 0.0
+        self.fail = False
+        self.choice_override = None
+
+    def select(self, **kw):
+        self.calls.append(kw)
+        if self.delay:
+            time.sleep(self.delay)
+        if self.fail:
+            raise RuntimeError("synthetic outage")
+        choice = self.choice_override or _reading(recommendation=self.pick)
+        return [_bound(self.gate, kw["requests"][0]), _bound(choice, kw["requests"][1])]
+
+    def receipt(self, **kw):
+        self.receipts.append(kw["receipt"])
+
+
+@pytest.fixture()
+def env(monkeypatch, request):
+    _Provider.requests, _Provider.queue = [], []
+    server = HTTPServer(("127.0.0.1", 0), _Provider)
+    threading.Thread(target=server.serve_forever, daemon=True).start()
+    home = tempfile.mkdtemp(prefix="hermes_native_")
+    os.makedirs(os.path.join(home, ".hermes"))
+    monkeypatch.setenv("HERMES_HOME", os.path.join(home, ".hermes"))
+    from hermes_cli.plugins import get_plugin_manager
+    manager = get_plugin_manager()
+    hook = Hook()
+    # The step machinery is tested with explicit sources; the default producers (yes/no, search
+    # follow-ups, executor) are covered in test_decision_points.
+    if request.module.__name__.endswith("test_decision_native"):
+        monkeypatch.setattr(dn, "_SOURCES", [dn.typed_options_source])
+    saved = {k: list(manager._hooks.get(k, [])) for k in (dn.HOOK, dn.RECEIPT_HOOK)}
+    manager._hooks[dn.HOOK] = [hook.select]
+    manager._hooks[dn.RECEIPT_HOOK] = [hook.receipt]
+    db = SessionDB(db_path=Path(home) / "state.db")
+    db.create_session(session_id="sess-native", source="cli")
+    def make_agent(admitted=True, tools=("read_file",), settings=None):
+        agent = AIAgent(
+            api_key="test-key", base_url=f"http://127.0.0.1:{server.server_address[1]}/v1",
+            provider="openai-compat", model="test-model", max_iterations=10, enabled_toolsets=[],
+            quiet_mode=True, skip_context_files=True, skip_memory=True, save_trajectories=False,
+            platform="cli", session_db=db, session_id="sess-native")
+        agent.valid_tool_names = set(tools)
+        agent.tools = [{"type": "function", "function": {"name": "read_file", "parameters": {
+            "type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]}}}]
+        agent._native_remote_admission = lambda: admitted
+        # work.executor is covered in test_decision_seams; excluding it keeps these tool.plan /
+        # ask.closed tests independent of which executors the host has on PATH.
+        agent._decision_settings = settings or Settings(enabled=True, exclude=frozenset({"work.executor", "code.approach"}))
+        return agent
+
+    try:
+        yield make_agent, hook, db
+    finally:
+        for k, v in saved.items():
+            manager._hooks[k] = v
+        server.shutdown()
+        db.close()
+        shutil.rmtree(home, ignore_errors=True)
+
+
+def _chat(requests):
+    return [r for r in requests if "messages" in r]
+
+
+def _closed(agent):
+    agent._native_closed_options = {"step_id": "synthetic.review", "state": {"question": "Approve the synthetic change?"},
+                                    "options": [dict(o) for o in OPTIONS]}
+
+
+def _roles(db):
+    return [m["role"] for m in db.get_messages_as_conversation("sess-native")]
+
+
+# ── closed answers ───────────────────────────────────────────────────────────
+
+def test_closed_answer_applies_without_provider_call_and_persists_normally(env):
+    make_agent, hook, db = env
+    agent = make_agent()
+    _closed(agent)
+    result = agent.run_conversation("approve it", conversation_history=[], task_id="t")
+    assert result["final_response"] == "Rejected: stopping.", hook.receipts          # pick=1 selects the second option
+    assert _chat(_Provider.requests) == []                              # no provider call
+    assert _roles(db) == ["user", "assistant"]
+    assert result["api_calls"] == 0
+    # One batched hook call carried the gate (noul) and the choice, with opaque option names.
+    assert len(hook.calls) == 1 and hook.calls[0]["source"] == dn.SOURCE_LABEL
+    # Generic descriptors only: the plugin owns the question wording.
+    kinds = [r["kind"] for r in hook.calls[0]["requests"]]
+    assert kinds == ["noul", "choice"] and all("question" not in r for r in hook.calls[0]["requests"])
+    assert hook.calls[0]["requests"][1]["options"] == [o["description"] for o in OPTIONS]
+    assert hook.calls[0]["requests"][0]["for"] == "ask.closed"
+    assert hook.calls[0]["requests"][1]["candidate_source"] == "typed_user_options"
+    # Receipts are public-safe: no option text, no answer, no user message.
+    points = [r["point_id"] for r in hook.receipts]
+    assert points == ["ask.decision_gate", "ask.closed"]
+    blob = json.dumps(hook.receipts)
+    assert "Rejected" not in blob and "approve it" not in blob
+    assert hook.receipts[-1]["status"] == "applied" and hook.receipts[-1]["outcome"] == "turn_ended"
+
+
+def test_gate_false_means_generative_and_goes_to_provider(env):
+    make_agent, hook, db = env
+    hook.gate = _reading(recommendation=False)
+    agent = make_agent()
+    _closed(agent)
+    _Provider.queue.append(_text("open-ended answer"))
+    result = agent.run_conversation("tell me a story instead", conversation_history=[], task_id="t")
+    assert result["final_response"] == "open-ended answer"
+    assert len(_chat(_Provider.requests)) == 1
+    assert hook.receipts[-1]["point_id"] == "ask.closed" and hook.receipts[-1]["status"] == "declined"
+    assert hook.receipts[-1]["fallback"] == "original"
+    assert _roles(db) == ["user", "assistant"]
+
+
+@pytest.mark.parametrize("fault", ["uncertain_gate", "uncertain_choice", "outage", "privacy", "unadmitted", "timeout"])
+def test_inadequate_or_failed_readings_use_the_provider(env, monkeypatch, fault):
+    make_agent, hook, db = env
+    agent = make_agent(admitted=fault != "unadmitted")
+    if fault == "uncertain_gate":
+        hook.gate = _reading(adequate=False, recommendation=None, reason="uncertainty")
+    if fault == "uncertain_choice":
+        hook.choice_override = _reading(adequate=False, recommendation=None, reason="uncertainty")
+    if fault == "outage":
+        hook.fail = True
+    if fault == "privacy":
+        hook.gate = _reading(evaluation="local_privacy_skip", adequate=False, reason="local_privacy_skip")
+        hook.choice_override = _reading(evaluation="local_privacy_skip", adequate=False, reason="local_privacy_skip")
+    if fault == "timeout":
+        agent._decision_settings = Settings(enabled=True, timeout_seconds=0.05, exclude=frozenset({"work.executor", "code.approach"}))
+        hook.delay = 0.8
+    _closed(agent)
+    _Provider.queue.append(_text("provider answer"))
+    result = agent.run_conversation("approve it", conversation_history=[], task_id="t")
+    assert result["final_response"] == "provider answer"
+    assert len(_chat(_Provider.requests)) == 1
+    if fault == "unadmitted":
+        assert hook.calls == []                      # nothing leaves without host admission
+    assert not any(r.get("status") == "applied" for r in hook.receipts)
+    assert _roles(db) == ["user", "assistant"]
+
+
