+"""ask.closed, code.approach, tool.plan, route.session, work.executor lanes and health at their
+native callsites, both master states. Synthetic text, in-process streaming provider, registered
+evaluator callback in the jevkit reading shape."""
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from agent import decision_executor, decision_health_hook, decision_native as dn, decision_seams, decision_sources
