@@ -0,0 +1,534 @@
+"""Host decision consumer: typed result validation, at-most-once journal, stale/revocation,
+crash and persistence outcomes. Offline; evaluators are fakes (plus the real typed
+evaluator when the sibling upstream checkout is present)."""
+from __future__ import annotations
+
+import sqlite3
+import threading
+
+import pytest
+
+from agent.decision_consumer import Consumer, Journal, POINTS
+
+CHOICE_Q = {"type": "choice", "instructions": "Which option fits?", "criteria": {"a": "one", "b": "two"}}
+NOUL_Q = {"type": "noul", "instructions": "Is it safe to proceed?"}
+SCORE_Q = {"type": "score", "instructions": "How good?", "criteria": ["bad", "ok", "great"]}
+POINT = "tool.plan"
+
+
+def verdict(point=POINT, source="code_enum", **over):
+    base = {"schema": "decision_receipt.v1", "point_id": point, "candidate_source": source,
+            "evaluation": "jev", "adequate": True, "recommendation": 1, "applied": None,
+            "fallback": "none", "reason": "usable", "margin": 0.5, "latency_ms": 12}
+    return {**base, **over}
+
+
+class Rig:
+    def __init__(self, tmp_path, result=None, scope=("profile", "session", "turn"), **kw):
+        self.journal = Journal(tmp_path / "journal" / "d.sqlite")
+        self.result = result if result is not None else verdict()
+        self.now = 0.0
+        self.revision = 1
+        self.values = [{"tool": "x"}, {"tool": "y"}]
+        self.executed, self.evaluated = [], []
+        self.admitted = True
+        self.settings = dict(kw)
+        self.scope = scope
+        self.consumer = self.make()
+
+    def make(self, **over):
+        kw = dict(journal=self.journal, binding=self.scope, evaluate=self.evaluate, admit=lambda: self.admitted,
+                  validate=lambda p, v: isinstance(v, dict), authorize=lambda p, v: True,
+                  clock=lambda: self.now, deadline=1.0)
+        kw.update(self.settings)
+        kw.update(over)
+        return Consumer(**kw)
+
+    def evaluate(self, state, requests, admission):
+        self.evaluated.append((state, requests))
+        if isinstance(self.result, Exception):
+            raise self.result
+        return self.result if isinstance(self.result, list) and not isinstance(self.result, dict) else [self.result]
+
+    def run(self, consumer=None, **over):
+        args = dict(point=POINT, step="s1", revision=self.revision, state={"public": 1}, question=CHOICE_Q,
+                    candidate_source="code_enum", values=self.values, execute=self.execute,
+                    current_revision=lambda: self.revision)
+        args.update(over)
+        return (consumer or self.consumer).run(**args)
+
+    def execute(self, value):
+        self.executed.append(value)
+        return "done"
+
+    def rows(self):
+        with sqlite3.connect(self.journal.path) as conn:
+            return conn.execute("SELECT status FROM decisions").fetchall()
+
+
+@pytest.fixture
+def rig(tmp_path):
+    return Rig(tmp_path)
+
+
+def test_applies_exactly_the_recommended_candidate_once_and_replays_safely(rig):
+    out = rig.run()
+    assert (out["status"], out["applied"], out["fallback"], out["outcome"]) == ("applied", 1, "none", "done")
+    assert rig.executed == [{"tool": "y"}]
+    assert rig.rows() == [("applied",)]
+    again = rig.run(consumer=rig.make())
+    assert (again["status"], again["fallback"], again["prior_status"]) == ("replayed", "original", "applied")
+    assert again["reconcile_required"] is True
+    assert rig.executed == [{"tool": "y"}] and len(rig.evaluated) == 1
+
+
+def test_execute_gets_a_copy_and_evaluator_gets_copies(rig):
+    def mutating(state, requests, admission):
+        state["public"] = 99
+        requests[0]["question"]["criteria"].clear()
+        return [verdict()]
+    caller_state = {"public": 1}
+    question = {**CHOICE_Q, "criteria": dict(CHOICE_Q["criteria"])}
+    rig.consumer = rig.make(evaluate=mutating)
+    out = rig.run(state=caller_state, question=question)
+    assert out["status"] == "applied" and caller_state == {"public": 1} and len(question["criteria"]) == 2
+    rig.executed[0]["tool"] = "tampered"
+    assert rig.values[1] == {"tool": "y"}
+
+
+def test_request_has_only_registered_fields(rig):
+    rig.run()
+    state, requests = rig.evaluated[0]
+    assert requests == [{"point": POINT, "question": CHOICE_Q, "candidate_source": "code_enum"}]
+
+
+@pytest.mark.parametrize("bad", [True, False, -1, 2, 1.0, "1", None, [1]])
+def test_recommendation_must_be_a_real_in_range_index(tmp_path, bad):
+    rig = Rig(tmp_path, verdict(recommendation=bad))
+    out = rig.run()
+    assert out["status"] == "invalid" and rig.executed == [] and rig.rows() == []
+
+
+def test_zero_is_a_valid_index(tmp_path):
+    rig = Rig(tmp_path, verdict(recommendation=0))
+    assert rig.run()["applied"] == 0 and rig.executed == [{"tool": "x"}]
+
+
+def test_noul_true_applies_the_single_candidate_false_declines(tmp_path):
+    rig = Rig(tmp_path, verdict(recommendation=True))
+    rig.values = [{"tool": "only"}]
+    assert rig.run(question=NOUL_Q)["status"] == "applied" and rig.executed == [{"tool": "only"}]
+    rig = Rig(tmp_path / "n", verdict(recommendation=False))
+    rig.values = [{"tool": "only"}]
+    out = rig.run(question=NOUL_Q)
+    assert (out["status"], out["recommendation"], out["fallback"]) == ("declined", False, "original")
+    assert rig.executed == [] and rig.rows() == []
+
+
+@pytest.mark.parametrize("bad", [1, 0, None, "true"])
+def test_noul_recommendation_must_be_boolean(tmp_path, bad):
+    rig = Rig(tmp_path, verdict(recommendation=bad))
+    rig.values = [{"tool": "only"}]
+    assert rig.run(question=NOUL_Q)["status"] == "invalid" and rig.executed == []
+
+
+def test_candidates_must_match_asked_options_one_to_one(rig):
+    assert rig.run(values=[{"a": 1}, {"a": 2}, {"a": 3}])["status"] == "invalid"
+    assert rig.run(question=NOUL_Q)["status"] == "invalid"  # two candidates for one yes/no
+    assert rig.run(question=SCORE_Q)["status"] == "invalid"
+    assert rig.run(question={"type": "bogus"})["status"] == "invalid"
+    assert rig.run(question=None)["status"] == "invalid"
+    assert rig.evaluated == [] and rig.executed == []
+
+
+def test_score_index_maps_to_level(tmp_path):
+    rig = Rig(tmp_path, verdict(recommendation=2))
+    rig.values = [{"n": 0}, {"n": 1}, {"n": 2}]
+    assert rig.run(question=SCORE_Q)["applied"] == 2 and rig.executed == [{"n": 2}]
+
+
+@pytest.mark.parametrize("over", [{"schema": "x"}, {"point_id": "route.effort"}, {"candidate_source": "source_records"},
+                                  {"applied": 0}, {"evaluation": "outage"}, {"adequate": 1}, {"adequate": "yes"}])
+def test_results_that_do_not_match_this_request_are_never_applied(tmp_path, over):
+    rig = Rig(tmp_path, verdict(**over))
+    out = rig.run()
+    assert out["status"] in ("invalid", "outage", "uncertainty") and rig.executed == [] and rig.rows() == []
+
+
+@pytest.mark.parametrize("bad", [[], [None], [[]], ["x"], None, RuntimeError("down"), TypeError("t")])
+def test_evaluator_garbage_or_exception_is_an_outage_never_a_raise(tmp_path, bad):
+    rig = Rig(tmp_path, bad)
+    if bad is None:
+        rig.result = None
+        rig.evaluate = lambda *a, **k: None
+        rig.consumer = rig.make(evaluate=rig.evaluate)
+    out = rig.run()
+    assert out["status"] == "outage" and out["fallback"] == "original" and rig.executed == []
+
+
+@pytest.mark.parametrize("reason", ["uncertainty", "outage", "budget_skip", "budget_timeout", "invalid",
+                                    "local_privacy_skip", "privacy_revoked"])
+def test_every_unusable_outcome_returns_to_the_original_branch(tmp_path, reason):
+    """No bespoke fallback lane: even a result that asks for one is reported as `original`."""
+    rig = Rig(tmp_path, verdict(adequate=False, evaluation=reason, reason=reason, recommendation=None,
+                                fallback="permitted_llm"))
+    out = rig.run()
+    assert (out["status"], out["fallback"]) == (reason, "original") and rig.executed == [] and rig.rows() == []
+
+
+def test_unknown_reason_is_not_trusted(tmp_path):
+    rig = Rig(tmp_path, verdict(adequate=False, evaluation="x", reason="grant_everything", fallback="sudo"))
+    out = rig.run()
+    assert (out["status"], out["fallback"]) == ("invalid", "original")
+
+
+def test_all_candidates_validated_before_anything_is_sent(rig):
+    seen = []
+    rig.consumer = rig.make(validate=lambda p, v: seen.append(v) or v != {"tool": "y"})
+    assert rig.run()["status"] == "invalid"
+    assert seen == [{"tool": "x"}, {"tool": "y"}] or {"tool": "y"} in seen
+    assert rig.evaluated == []
+
+
+@pytest.mark.parametrize("validator", [lambda p, v: 1, lambda p, v: None, lambda p, v: "yes",
+                                       lambda p, v: (_ for _ in ()).throw(RuntimeError("x"))])
+def test_validate_must_return_exactly_true_and_may_not_crash_the_turn(rig, validator):
+    rig.consumer = rig.make(validate=validator)
+    assert rig.run()["status"] == "invalid" and rig.evaluated == []
+
+
+def test_authorize_is_a_hard_gate_on_the_selected_value(rig):
+    rig.consumer = rig.make(authorize=lambda p, v: v == {"tool": "x"})
+    out = rig.run()
+    assert (out["status"], out["fallback"]) == ("policy_denied", "original")
+    assert rig.executed == [] and rig.rows() == []
+    for bad in (lambda p, v: 1, lambda p, v: (_ for _ in ()).throw(RuntimeError("x"))):
+        rig.consumer = rig.make(authorize=bad)
+        assert rig.run()["status"] == "policy_denied"
+
+
+def test_authorize_cannot_alter_the_candidate_that_runs(rig):
+    def sneaky(point, value):
+        value["tool"] = "evil"
+        return True
+    rig.consumer = rig.make(authorize=sneaky)
+    rig.run()
+    assert rig.executed == [{"tool": "y"}]
+
+
+def test_admission_checked_before_during_and_after(tmp_path):
+    rig = Rig(tmp_path)
+    rig.admitted = False
+    out = rig.run()
+    assert (out["status"], out["fallback"]) == ("local_privacy_skip", "original") and rig.evaluated == []
+
+    rig = Rig(tmp_path / "2")
+
+    def revoking(state, requests, admission):
+        rig.admitted = False
+        return [verdict()]
+    rig.consumer = rig.make(evaluate=revoking)
+    out = rig.run()
+    assert (out["status"], out["fallback"]) == ("privacy_revoked", "original")
+    assert rig.executed == [] and rig.rows() == []
+
+
+@pytest.mark.parametrize("admit", [lambda: 1, lambda: "yes", lambda: None,
+                                   lambda: (_ for _ in ()).throw(RuntimeError("x"))])
+def test_admission_must_be_exactly_true(tmp_path, admit):
+    rig = Rig(tmp_path, admit=admit)
+    assert rig.run()["status"] == "local_privacy_skip" and rig.evaluated == []
+
+
+def test_source_revocation_blocks_before_send_and_before_execution(tmp_path):
+    live = {"ok": True}
+    rig = Rig(tmp_path, source_current=lambda: live["ok"])
+    live["ok"] = False
+    assert rig.run()["status"] == "local_privacy_skip" and rig.evaluated == []
+    live["ok"] = True
+
+    def revoke_mid(state, requests, admission):
+        live["ok"] = False
+        return [verdict()]
+    rig.consumer = rig.make(evaluate=revoke_mid)
+    out = rig.run()
+    assert out["status"] == "privacy_revoked" and rig.executed == []
+    live["ok"] = lambda: (_ for _ in ()).throw(RuntimeError("x"))
+    rig.consumer = rig.make(source_current=lambda: (_ for _ in ()).throw(RuntimeError("x")))
+    assert rig.run(step="s2")["status"] == "local_privacy_skip"
+
+
+def test_revocation_after_reservation_releases_the_claim_without_effect(tmp_path):
+    rig = Rig(tmp_path)
+    calls = {"n": 0}
+
+    def admit():  # clear before send, after evaluate, and then revoked right after reserve
+        calls["n"] += 1
+        return calls["n"] <= 2
+    rig.consumer = rig.make(admit=admit)
+    out = rig.run()
+    assert (out["status"], out["fallback"]) == ("privacy_revoked", "original")
+    assert rig.executed == [] and rig.rows() == []
+    rig.consumer = rig.make()
+    assert rig.run()["status"] == "applied"  # the claim was given back, not burned
+
+
+def test_stale_revision_mutation_and_deadline(tmp_path):
+    rig = Rig(tmp_path)
+
+    def bump(state, requests, admission):
+        rig.revision = 2
+        return [verdict()]
+    rig.consumer = rig.make(evaluate=bump)
+    assert rig.run()["status"] == "stale" and rig.executed == []
+
+    rig = Rig(tmp_path / "m")
+
+    def mutate(state, requests, admission):
+        rig.values[1]["tool"] = "changed"
+        return [verdict()]
+    rig.consumer = rig.make(evaluate=mutate)
+    assert rig.run()["status"] == "stale" and rig.executed == [] and rig.rows() == []
+
+    rig = Rig(tmp_path / "t")
+
+    def slow(state, requests, admission):
+        rig.now += 1.5
+        return [verdict()]
+    rig.consumer = rig.make(evaluate=slow)
+    assert rig.run()["status"] == "stale" and rig.executed == []
+
+
+def test_unreadable_or_backwards_clock_is_stale(tmp_path):
+    for clock in (lambda: float("nan"), lambda: (_ for _ in ()).throw(RuntimeError("x")), lambda: "now"):
+        rig = Rig(tmp_path / str(id(clock)), clock=clock)
+        assert rig.run()["status"] == "stale" and rig.executed == []
+    rig = Rig(tmp_path / "b")
+
+    def backwards(state, requests, admission):
+        rig.now -= 5
+        return [verdict()]
+    rig.consumer = rig.make(evaluate=backwards)
+    assert rig.run()["status"] == "stale"
+
+
+def test_current_revision_failure_is_stale(rig):
+    assert rig.run(current_revision=lambda: (_ for _ in ()).throw(RuntimeError("x")))["status"] == "stale"
+    assert rig.executed == []
+
+
+def test_revision_change_between_reserve_and_execute_releases_claim(tmp_path):
+    rig = Rig(tmp_path)
+    reads = {"n": 0}
+
+    def current():
+        reads["n"] += 1
+        return 1 if reads["n"] <= 1 else 2  # fresh at the pre-reserve check only
+    out = rig.run(current_revision=current)
+    assert out["status"] == "stale" and rig.executed == [] and rig.rows() == []
+
+
+def test_crash_after_reserve_never_repeats_the_effect(tmp_path):
+    rig = Rig(tmp_path)
+
+    def crash(value):
+        raise KeyboardInterrupt  # process-fatal: not an Exception, no settle happens
+    with pytest.raises(KeyboardInterrupt):
+        rig.run(execute=crash)
+    assert rig.rows() == [("reserved",)]
+    again = rig.run(consumer=rig.make())
+    assert (again["status"], again["prior_status"], again["fallback"]) == ("replayed", "reserved", "original")
+    assert again["reconcile_required"] is True
+    assert rig.executed == []
+
+
+def test_execution_error_is_settled_and_not_retried(rig):
+    def fail(value):
+        raise RuntimeError("tool exploded")
+    out = rig.run(execute=fail)
+    assert (out["status"], out["fallback"], out["settled"]) == ("execution_error", "original", True)
+    assert out["reconcile_required"] is True
+    assert rig.rows() == [("execution_error",)]
+    assert rig.run(consumer=rig.make())["status"] == "replayed"
+    assert rig.executed == []
+
+
+def test_journal_outages_fail_closed(tmp_path):
+    rig = Rig(tmp_path)
+
+    class Broken:
+        def read(self, b):
+            raise sqlite3.OperationalError("locked")
+    rig.consumer = rig.make(journal=Broken())
+    assert rig.run()["status"] == "journal_unavailable" and rig.executed == [] and rig.evaluated == []
+
+    class NoReserve(Journal):
+        def reserve(self, b, r):
+            raise sqlite3.OperationalError("disk full")
+    rig.consumer = rig.make(journal=NoReserve(tmp_path / "x.sqlite"))
+    assert rig.run()["status"] == "journal_unavailable" and rig.executed == []
+
+
+def test_settle_failure_after_effect_keeps_claim_and_reports_unsettled(tmp_path):
+    rig = Rig(tmp_path)
+
+    class Flaky(Journal):
+        def settle(self, *a):
+            raise sqlite3.OperationalError("disk full")
+    flaky = Flaky(tmp_path / "f.sqlite")
+    rig.consumer = rig.make(journal=flaky)
+    out = rig.run()
+    assert (out["status"], out["settled"], out["outcome"]) == ("applied", False, "done")
+    assert rig.run(consumer=rig.make(journal=flaky))["status"] == "replayed" and len(rig.executed) == 1
+
+
+def test_concurrent_consumers_execute_at_most_once(tmp_path):
+    rig = Rig(tmp_path)
+    barrier, results = threading.Barrier(8), []
+
+    def worker():
+        consumer = rig.make()
+        barrier.wait()
+        results.append(rig.run(consumer=consumer)["status"])
+    threads = [threading.Thread(target=worker) for _ in range(8)]
+    [t.start() for t in threads]
+    [t.join() for t in threads]
+    assert len(rig.executed) == 1
+    assert results.count("applied") == 1 and set(results) <= {"applied", "replayed", "journal_unavailable"}
+
+
+def test_binding_separates_scope_step_revision_and_candidates(tmp_path):
+    rig = Rig(tmp_path)
+    assert rig.run()["status"] == "applied"
+    assert rig.run(step="s2")["status"] == "applied"
+    assert rig.run(values=[{"tool": "x"}, {"tool": "z"}])["status"] == "applied"
+    rig.revision = 2
+    assert rig.run()["status"] == "applied"
+    other = rig.make(binding=("p2", "session", "turn"))
+    rig.revision = 1
+    assert rig.run(consumer=other)["status"] == "applied"
+    assert rig.run()["status"] == "replayed"
+    assert len(rig.executed) == 5
+
+
+def test_nonfinite_provider_numbers_cannot_break_the_journal(tmp_path):
+    rig = Rig(tmp_path, verdict(margin=float("nan"), latency_ms=float("inf")))
+    out = rig.run()
+    assert out["status"] == "applied" and out["margin"] is None and out["latency_ms"] is None
+    assert rig.rows() == [("applied",)]
+
+
+def test_provider_sidecars_are_not_copied_into_receipts(tmp_path):
+    rig = Rig(tmp_path, verdict(reading={"secret": "x"}, model="m", tool_call_id="call_1", extra="e"))
+    out = rig.run()
+    assert not {"reading", "model", "tool_call_id", "extra"} & set(out)
+
+
+def test_non_json_values_or_revision_are_invalid_not_a_crash(rig):
+    assert rig.run(values=[{"a": object()}, {"b": 1}])["status"] == "invalid"
+    assert rig.run(values=[{"a": float("nan")}, {"b": 1}])["status"] == "invalid"
+    assert rig.run(revision=object())["status"] == "invalid"
+    assert rig.evaluated == [] and rig.executed == []
+
+
+def test_programmer_errors_raise(rig, tmp_path):
+    for over in ({"point": "made.up"}, {"step": ""}, {"step": 3}, {"values": []}, {"values": ()},
+                 {"candidate_source": "model_said_so"}, {"execute": None}, {"current_revision": 1}):
+        with pytest.raises(ValueError):
+            rig.run(**over)
+    for bad in (dict(binding=("a", "b")), dict(binding=("a", "", "c")), dict(binding=["a", "b", "c"]),
+                dict(evaluate=None), dict(deadline=0), dict(deadline=float("nan")), dict(deadline=True),
+                dict(source_current=3)):
+        with pytest.raises(ValueError):
+            rig.make(**bad)
+
+
+def test_journal_file_is_private_and_connections_are_released(tmp_path):
+    journal = Journal(tmp_path / "private" / "j.sqlite")
+    assert (journal.path.stat().st_mode & 0o777) == 0o600
+    for i in range(200):
+        journal.reserve(f"b{i}", {"i": i})
+    assert journal.read("b199") == ("reserved", {"i": 199})
+    assert journal.reserve("b1", {}) is False
+    journal.settle("b1", "applied", {"i": 1})
+    with pytest.raises(ValueError):
+        journal.settle("b1", "applied", {})
+    journal.release("b1")  # only reserved rows can be released
+    assert journal.read("b1")[0] == "applied"
+    journal.release("b2")
+    assert journal.read("b2") is None
+
+
+def test_only_in_flight_outcomes_require_canonical_reconciliation(tmp_path):
+    """reconcile_required is the reviewer-visible line between 'run the original branch' and
+    'the effect may already be running: ask the original executor to reconcile it'."""
+    clean = {"invalid", "outage", "uncertainty", "stale", "policy_denied", "local_privacy_skip",
+             "privacy_revoked", "declined", "budget_skip", "budget_timeout", "excluded", "applied"}
+    seen = {}
+    for reason in ("uncertainty", "outage", "excluded", "budget_timeout", "privacy_revoked"):
+        rig = Rig(tmp_path / reason, verdict(adequate=False, evaluation=reason, reason=reason,
+                                              recommendation=None))
+        seen[reason] = rig.run()
+    rig = Rig(tmp_path / "ok")
+    seen["applied"] = rig.run()
+    seen["replayed"] = rig.run(consumer=rig.make())
+    seen["execution_error"] = Rig(tmp_path / "err").run(execute=lambda v: 1 / 0)
+    for status, out in seen.items():
+        assert out["status"] == status
+        assert out["reconcile_required"] is (status not in clean), status
+        assert out["fallback"] == ("none" if status == "applied" else "original"), status
+
+
+def test_replay_never_calls_execute_authorize_or_evaluate_again(tmp_path):
+    rig = Rig(tmp_path)
+    rig.run()
+    calls = []
+    again = rig.make(authorize=lambda p, v: calls.append(v) or True)
+    out = rig.run(consumer=again)
+    assert out["status"] == "replayed" and calls == [] and len(rig.executed) == 1 and len(rig.evaluated) == 1
+
+
+def test_consumer_is_not_an_authority_authorize_and_execute_are_the_hosts(rig):
+    """The decision only picks among candidates; the owner's authorize decides whether it may run,
+    and it is asked about exactly the selected candidate immediately before execute."""
+    order = []
+    rig.consumer = rig.make(authorize=lambda p, v: order.append(("authorize", p, v)) or True)
+    rig.run(execute=lambda v: order.append(("execute", v)))
+    assert order == [("authorize", POINT, {"tool": "y"}), ("execute", {"tool": "y"})]
+    with pytest.raises(ValueError):
+        rig.make(authorize=None)
+    with pytest.raises(ValueError):
+        rig.make(authorize=True)
+
+
+def test_excluded_result_is_a_normal_unusable_outcome(tmp_path):
+    rig = Rig(tmp_path, verdict(adequate=False, evaluation="excluded", reason="excluded", recommendation=None))
+    out = rig.run()
+    assert (out["status"], out["fallback"], out["recommendation"]) == ("excluded", "original", None)
+    assert rig.executed == [] and rig.rows() == []
+
+
+def test_numeric_diagnostics_are_copied_but_names_and_raw_keys_are_not(tmp_path):
+    rig = Rig(tmp_path, verdict(confidence=0.8, probabilities=[0.1, 0.9], input_tokens=412, output_tokens=40,
+                                batch_size=2, option_ids=["a", "b"], usage={"raw": 1}))
+    out = rig.run()
+    assert (out["confidence"], out["probabilities"], out["input_tokens"], out["output_tokens"],
+            out["batch_size"]) == (0.8, [0.1, 0.9], 412, 40, 2)
+    assert not {"option_ids", "usage"} & set(out)
+    assert rig.rows() == [("applied",)]
+
+
+@pytest.mark.parametrize("bad", [
+    {"confidence": float("nan"), "probabilities": [float("inf")], "input_tokens": -3, "output_tokens": 1.5,
+     "batch_size": 0},
+    {"confidence": 2, "probabilities": ["a", "b"], "input_tokens": True, "output_tokens": "9", "batch_size": None},
+    {"confidence": True, "probabilities": {"a": 0.5}, "input_tokens": float("nan"), "batch_size": float("inf")},
+    {"probabilities": [0.5] * 256},
+])
+def test_malformed_diagnostics_become_none_and_never_break_the_journal(tmp_path, bad):
+    rig = Rig(tmp_path, verdict(**bad))
+    out = rig.run()
+    assert out["status"] == "applied"
+    assert out["confidence"] is None and out["probabilities"] is None
+    assert out["input_tokens"] is None and out["output_tokens"] is None and out["batch_size"] is None
+    assert rig.rows() == [("applied",)]
