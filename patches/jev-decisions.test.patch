+
+
+class Evaluator:
+    def __init__(self):
+        self.picks, self.gates, self.calls, self.reason = {}, {}, [], None
+
+    def __call__(self, **kw):
+        self.calls.append(kw)
+        out = []
+        for r in kw["requests"]:
+            if self.reason:
+                out.append(_bound(_reading(adequate=False, evaluation=self.reason, reason=self.reason), r))
+            elif r["point"] == "ask.decision_gate":
+                out.append(_bound(_reading(recommendation=self.gates.get(r.get("for"), True)), r))
+            else:
+                out.append(_bound(_reading(recommendation=self.picks.get(r["point"])), r))
+        return out
+
+
+@pytest.fixture()
+def ev(env):
+    make_agent, hook, db = env
+    from hermes_cli.plugins import get_plugin_manager
+    evaluator = Evaluator()
+    get_plugin_manager()._hooks[decision_seams.HOOK] = [evaluator]
+    return make_agent, evaluator, hook
