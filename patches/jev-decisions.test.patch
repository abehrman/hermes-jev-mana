+def test_skill_pick_loads_into_the_user_row_and_off_is_byte_identical(seam, monkeypatch):
+    make_agent, evaluator, _ = seam
+    loaded = []
+    _skills(monkeypatch, loaded)
+    off = _turn(make_agent, Settings())
+    assert evaluator.calls == [] and loaded == [] and "Jev preflight" not in off[0]
+    original = _turn(make_agent, _on(exclude=frozenset({"work.executor", "skill.pick", "code.approach"})))
+    evaluator.picks["skill.pick"] = 2
+    on = _turn(make_agent, _on(exclude=frozenset({"work.executor", "code.approach"})))
+    assert loaded == ["synthetic-beta"]
+    assert "[SKILL synthetic-beta]" in on[0] and "[SKILL" not in original[0]
+    assert evaluator.calls[0]["requests"][0]["options"][0] == "No skill is needed."
+    # Forced fallbacks: outage, near tie, excluded point -> the original payload, byte for byte.
+    for setup in ("outage", "tie", "excluded"):
+        loaded.clear()
+        evaluator.fail = setup == "outage"
+        settings = _on(exclude=frozenset({"work.executor", "code.approach"} | ({"skill.pick"} if setup == "excluded" else set())),
+                       margin=0.99 if setup == "tie" else 0.15)
+        assert _turn(make_agent, settings) == original and loaded == [], setup
+    evaluator.fail = False
+
