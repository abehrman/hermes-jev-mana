+"""Boot/update/on-demand trigger for decision health. Off (the default) returns before any hook
+lookup; on, the registered ``decision_health_check`` plugin hook assesses and records status."""
+from __future__ import annotations
+
+
+def run_health_check(trigger: str):
+    from agent import decision_seams
+    if not decision_seams.settings_for(None).enabled:
+        return None
+    from hermes_cli.plugins import has_hook, invoke_hook
+    if not has_hook("decision_health_check"):
+        return None
+    results = invoke_hook("decision_health_check", trigger=trigger)
+    return next((r for r in results if isinstance(r, dict)), None)
diff --git a/agent/decision_native.py b/agent/decision_native.py
new file mode 100644
index 00000000..cb6b811d
--- /dev/null
+++ b/agent/decision_native.py
@@ -0,0 +1,539 @@
+"""Native pre-provider decision step for the conversation loop.
+
+Before each provider call the loop asks ``select_native_step`` whether code has enumerated a
+closed domain for this step: typed host options for a closed answer, allowed next-step tool
+plans, or configured work-executor classes. If so, one batched ``select_agent_step`` hook call
+carries a free-form Noul gate request and a Choice request (generic descriptors from
+``decision_seams``; the plugin owns the wording). Only an adequate gate plus an adequate choice
+is applied, through the ordinary final-response or tool-round path. Anything else falls through
+to the configured provider.
+
+Code owns source labels, candidates, validation, permissions and execution; the hook only returns
+typed readings. Provider-emitted tool-call identities, sidecars and signatures are never touched:
+a selected plan becomes a host-minted tool-call turn that runs the unmodified tool round.
+
+Not covered: free-form entity extraction, and any step for which no host source enumerates
+alternatives (those turns go straight to the provider). Selection never authorizes a side effect;
+approvals and ``pre_tool_call`` run in the tool round as usual.
+"""
+from __future__ import annotations
+
+import concurrent.futures
+import contextvars
+import copy
+import json
+import logging
+import uuid
+from dataclasses import dataclass, field
+from types import SimpleNamespace
+from typing import Any, Callable, Dict, List, Optional
+
+import os
+
+from agent import decision_config
+from agent.decision_consumer import Consumer
+from agent.decision_seams import (HOOK, RECEIPT_HOOK, SOURCE_LABEL, PUBLIC_FIELDS as _PUBLIC_FIELDS, call_hook as _call_hook,
+                                  emit as _emit, readings_ok as _readings_ok, remote_admitted as _remote_admitted,
+                                  _journal)
+
+logger = logging.getLogger("agent.decision_native")
+
+GATE_POINT = "ask.decision_gate"
+MAX_NATIVE_STEPS = 8
+MAX_OPTIONS = 16
+READ_ONLY_TOOLS = frozenset({"read_file", "search_files", "web_search", "web_extract"})
+
+# Source labels are derived from the step kind here, never claimed by a source.
+_KINDS = {
+    "closed_answer": ("ask.closed", "typed_user_options"),
+    "tool_plan": ("tool.plan", "code_enum"),
+    "executor": ("work.executor", "code_enum"),
+    "yes_no": ("ask.closed", "code_enum"),
+}
+
+
+@dataclass(frozen=True)
+class Turn:
+    """What a step source may read: the user text, whether the turn has no assistant rows yet,
+    and a deep copy of this turn's rows after the user message (tool results the step follows)."""
+    user_message: str
+    turn_id: str
+    first: bool
+    rows: tuple = ()
+
+
+@dataclass
+class NativeStep:
+    """One code-enumerated decision. ``options`` are exact host alternatives.
+
+    closed_answer: {"id", "description", "answer"}; the selected ``answer`` is delivered verbatim.
+    tool_plan: {"id", "description", "calls": [{"tool", "args"}]}.
+    ``draft`` (tool_plan only) is a host LLM drafter used when code cannot enumerate; drafted
+    plans are labelled bounded_llm_draft, recorded, validated alike and must be read-only.
+    """
+    kind: str
+    step_id: str
+    revision: str
+    state: Dict[str, Any] = field(default_factory=dict)
+    options: List[Dict[str, Any]] = field(default_factory=list)
+    effects: str = "read_only"          # or "ordinary_policy": tools then pass pre_tool_call/approvals
+    draft: Optional[Callable] = None
+
+
+_SOURCES: List[Callable] = []
+
+
+def register_step_source(fn: Callable) -> Callable:
+    """Register a code-owned ``fn(agent, turn) -> NativeStep | None``. Returns ``fn``."""
+    if fn not in _SOURCES:
+        _SOURCES.append(fn)
+    return fn
+
+
+def unregister_step_source(fn: Callable) -> None:
+    if fn in _SOURCES:
+        _SOURCES.remove(fn)
+
+
+def typed_options_source(agent, turn: Turn) -> Optional[NativeStep]:
+    """Surface-supplied typed closed question: ``agent._native_closed_options`` is a dict
+    {"step_id", "state", "options"} a surface sets for the turn that answers it. Only the
+    first provider step of the turn is eligible."""
+    spec = getattr(agent, "_native_closed_options", None)
+    if not isinstance(spec, dict) or not turn.first:
+        return None
+    return NativeStep(kind="closed_answer", step_id=str(spec.get("step_id") or ""),
+                      revision=turn.turn_id, state=spec.get("state") or {},
+                      options=copy.deepcopy(spec.get("options") or []))
+
+
+register_step_source(typed_options_source)
+
+_FOLLOWUP_TOOLS = {"web_search": "web_extract", "search_files": "read_file"}
+_YES_NO = [{"id": "yes", "description": "Yes", "answer": "Yes."},
+           {"id": "no", "description": "No", "answer": "No."}]
+MAX_EVIDENCE = 6000
+
+
+def yes_no_source(agent, turn: Turn) -> Optional[NativeStep]:
+    """ask.closed over the code-enumerated boolean domain, only once this turn has tool evidence.
+    The gate (plugin wording) decides whether the raw ask is a closed yes/no question the evidence
+    settles; no evidence means no step and the original branch."""
+    evidence = [str(r.get("content") or "")[:2000] for r in turn.rows
+                if isinstance(r, dict) and r.get("role") == "tool"][-3:]
+    if not evidence or not turn.rows or turn.rows[-1].get("role") != "tool":
+        return None
+    return NativeStep(kind="yes_no", step_id="ask.closed.yes_no", revision=turn.turn_id,
+                      state={"evidence": "\n---\n".join(evidence)[:MAX_EVIDENCE]}, options=copy.deepcopy(_YES_NO))
+
+
+def user_options_source(agent, turn: Turn) -> Optional[NativeStep]:
+    """ask.closed from options the user supplied verbatim as JSON: {"question", "options": [..]}.
+    The answer is the exact option string; nothing is extracted from prose."""
+    if not turn.first:
+        return None
+    try:
+        spec = json.loads(turn.user_message)
+    except (TypeError, ValueError):
+        return None
+    options = spec.get("options") if isinstance(spec, dict) else None
+    if (not isinstance(spec.get("question") if isinstance(spec, dict) else None, str)
+            or not isinstance(options, list) or not all(isinstance(o, str) for o in options)):
+        return None
+    return NativeStep(kind="closed_answer", step_id="ask.closed.user_options", revision=turn.turn_id,
+                      state={"question": spec["question"]},
+                      options=[{"id": f"o{i}", "description": o[:300], "answer": o} for i, o in enumerate(options)])
+_EXECUTOR_TEXT = {
+    "create": "Create something new from scratch: a new project, app, script, feature or artifact.",
+    "maintain": "Work on something that already exists: fix, change, review, explain or operate it.",
+}
+
+
+def _last_tool_result(turn: Turn):
+    """(tool name, call id, content) of this turn's newest tool row, from the host's own rows."""
+    rows = list(turn.rows)
+    if not rows or not isinstance(rows[-1], dict) or rows[-1].get("role") != "tool":
+        return None
+    call_id = rows[-1].get("tool_call_id")
+    for row in reversed(rows[:-1]):
+        for call in (row.get("tool_calls") or []) if isinstance(row, dict) else ():
+            fn = call.get("function") if isinstance(call, dict) else None
+            if isinstance(fn, dict) and call.get("id") == call_id:
+                return fn.get("name"), str(call_id), rows[-1].get("content")
+    return None
+
+
+def search_followup_source(agent, turn: Turn) -> Optional[NativeStep]:
+    """tool.plan from a code-known workflow: after a web_search result, the follow-up is one
+    extraction of a URL the search actually returned (never a new query)."""
+    found = _last_tool_result(turn)
+    follow = _FOLLOWUP_TOOLS.get(found[0]) if found else None
+    if not follow or follow not in (getattr(agent, "valid_tool_names", None) or ()):
+        return None
+    if found[0] == "search_files":
+        options = _file_followups(found[2])
+    else:
+        try:
+            items = json.loads(found[2])["data"]["web"]
+        except Exception:
+            return None
+        from agent.decision_sources import public_url
+        options = [{"id": f"r{n}", "description": str(item.get("title") or item.get("description") or "")[:200],
+                    "calls": [{"tool": follow, "args": {"urls": [item["url"]]}}]}
+                   for n, item in enumerate(items[:4] if isinstance(items, list) else [])
+                   if isinstance(item, dict) and public_url(item.get("url"))]
+    return NativeStep(kind="tool_plan", step_id="search.followup", revision=found[1],
+                      state={"results": [o["description"] for o in options]}, options=options)
+
+
+def _file_followups(content) -> list:
+    """search_files -> read_file of paths the search returned: one option per file, plus one
+    plan reading the first three together (independent reads run as one parallel tool round)."""
+    try:
+        doc = json.loads(content)
+    except (TypeError, ValueError):
+        return []
+    paths = [p for p in (doc.get("files") or []) if isinstance(p, str)] if isinstance(doc, dict) else []
+    if isinstance(doc, dict) and not paths:
+        paths = [m.get("path") for m in doc.get("matches") or [] if isinstance(m, dict) and isinstance(m.get("path"), str)]
+    paths = list(dict.fromkeys(paths))[:4]
+    options = [{"id": f"f{n}", "description": f"Read {p}"[:300], "calls": [{"tool": "read_file", "args": {"path": p}}]}
+               for n, p in enumerate(paths)]
+    if len(paths) >= 2:
+        options.append({"id": "all", "description": "Read " + ", ".join(paths[:3]),
+                        "calls": [{"tool": "read_file", "args": {"path": p}} for p in paths[:3]]})
+    return options
+
+
+def executor_source(agent, turn: Turn) -> Optional[NativeStep]:
+    """work.executor: the first step of a top-level turn may go to a configured executor class.
+    Delegated children and side agents never select an executor (no recursion)."""
+    if (not turn.first or getattr(agent, "_delegate_depth", 0) or getattr(agent, "side_agent", False)
+            or getattr(agent, "parent_session_id", None)):
+        return None
+    executors = decision_config.for_agent(agent).executors
+    if not any(e.get("type") != "hermes" for e in executors.values()):
+        return None
+    options = [{"id": name, "description": str(entry.get("description") or _EXECUTOR_TEXT.get(name, ""))[:300]}
+               for name, entry in sorted(executors.items())]
+    options = [o for o in options if o["description"]]
+    cwd = getattr(agent, "session_cwd", None) or os.getcwd()
+    from agent.decision_executor import repo_signals
+    return NativeStep(kind="executor", step_id="work.executor", revision=turn.turn_id,
+                      state=repo_signals(cwd, turn.user_message), options=options)
+
+
+register_step_source(user_options_source)
+register_step_source(executor_source)
+register_step_source(search_followup_source)
+register_step_source(yes_no_source)
+
+
+def remote_admitted(agent) -> bool:
+    return _remote_admitted(agent)
+
+
+# ── validation ───────────────────────────────────────────────────────────────
+
+def _text(value, limit) -> bool:
+    return isinstance(value, str) and bool(value.strip()) and len(value) <= limit
+
+
+def _schema_ok(agent, tool: str, args) -> bool:
+    if not isinstance(args, dict):
+        return False
+    for entry in getattr(agent, "tools", None) or ():
+        fn = entry.get("function") if isinstance(entry, dict) else None
+        if isinstance(fn, dict) and fn.get("name") == tool:
+            schema = dict(fn.get("parameters") or {"type": "object"})
+            schema.setdefault("additionalProperties", False)
+            try:
+                from jsonschema import Draft202012Validator
+                Draft202012Validator(schema).validate(args)
+                return True
+            except Exception:
+                return False
+    return False
+
+
+def _valid_value(agent, step: NativeStep, drafted: bool, value) -> bool:
+    if not isinstance(value, dict) or not _text(value.get("id"), 64) or not _text(value.get("description"), 300):
+        return False
+    if step.kind in ("closed_answer", "yes_no"):
+        return set(value) == {"id", "description", "answer"} and _text(value["answer"], 4000)
+    if step.kind == "executor":
+        from agent import decision_executor
+        entry = decision_config.for_agent(agent).executors.get(value["id"])
+        return set(value) == {"id", "description"} and decision_executor.ready(agent, entry)
+    calls = value.get("calls")
+    if set(value) != {"id", "description", "calls"} or not isinstance(calls, list) or not 1 <= len(calls) <= 4:
+        return False
+    valid_names = getattr(agent, "valid_tool_names", None) or ()
+    for call in calls:
+        if not isinstance(call, dict) or set(call) != {"tool", "args"}:
+            return False
+        tool = call["tool"]
+        if not isinstance(tool, str) or tool not in valid_names or not _schema_ok(agent, tool, call["args"]):
+            return False
+        if (drafted or step.effects == "read_only") and tool not in READ_ONLY_TOOLS:
+            return False
+    return True
+
+
+def _normalize(agent, step, drafted: bool, options) -> Optional[list]:
+    if (not isinstance(step, NativeStep) or step.kind not in _KINDS
+            or not _text(step.step_id, 128) or not _text(step.revision, 256)
+            or step.effects not in ("read_only", "ordinary_policy")
+            or not isinstance(options, list) or not 2 <= len(options) <= MAX_OPTIONS):
+        return None
+    values = copy.deepcopy(options)
+    ids = [v.get("id") if isinstance(v, dict) else None for v in values]
+    if len(set(map(str, ids))) != len(ids) or not all(_valid_value(agent, step, drafted, v) for v in values):
+        return None
+    try:
+        json.dumps(step.state, allow_nan=False)
+    except (TypeError, ValueError):
+        return None
+    return values
+
+
+# ── generic request descriptors (the plugin owns the question wording) ─────────
+
+def _descriptors(step: NativeStep, values, point: str, label: str):
+    options = [v["description"] for v in values]
+    if step.kind == "yes_no":
+        return ({"point": GATE_POINT, "kind": "noul", "candidate_source": "code_enum", "step": step.step_id,
+                 "for": "ask.closed.yes_no", "options": options},
+                {"point": point, "kind": "noul", "candidate_source": label, "step": step.step_id, "options": options})
+    return ({"point": GATE_POINT, "kind": "noul", "candidate_source": "code_enum", "step": step.step_id,
+             "for": point, "options": options},
+            {"point": point, "kind": "choice", "candidate_source": label, "step": step.step_id, "options": options})
+
+
+# ── hook transport ───────────────────────────────────────────────────────────
+
+class _Batch:
+    """Consumer ``evaluate`` adapter: one hook round trip carries the gate and the choice."""
+
+    def __init__(self, agent, turn_id, step, gate_request, choice_request, settings):
+        self.agent, self.turn_id, self.step, self.gate_request = agent, turn_id, step, gate_request
+        self.choice_request = choice_request
+        self.settings = settings
+        self.gate: Optional[dict] = None
+        self.generative = False
+
+    def __call__(self, state, requests, *, admission):
+        batch = [self.gate_request, self.choice_request]
+        replies = _call_hook(
+            HOOK, self.settings.timeout_seconds, requests=batch, state=state, admission=admission, source=SOURCE_LABEL,
+            session_id=str(getattr(self.agent, "session_id", "") or ""), turn_id=self.turn_id,
+            step_id=self.step.step_id, deadline=self.settings.timeout_seconds,
+            budget=self.settings.turn_budget_seconds, margin=self.settings.margin)
+        results = next((r for r in replies if _readings_ok(r, len(batch))), None)
+        if results is None:
+            raise RuntimeError("no_valid_reading")
+        self.gate, main = results[0], dict(results[1])
+        margin = main.get("margin")
+        if self.step.kind == "yes_no":
+            if isinstance(main.get("recommendation"), bool):
+                main["recommendation"] = 0 if main["recommendation"] else 1      # Yes / No
+            margin = self.settings.margin                                      # noul bands, not a tie
+        if main.get("adequate") is True and not (isinstance(margin, (int, float)) and not isinstance(margin, bool)
+                                                 and margin >= self.settings.margin):
+            main.update(adequate=False, recommendation=None, reason="uncertainty")   # near tie
+        if main.get("evaluation") == "jev":
+            if self.gate.get("evaluation") != "jev" or not self.gate.get("adequate"):
+                main.update(adequate=False, recommendation=None, reason=str(self.gate.get("reason") or "uncertainty"))
+            elif self.gate.get("recommendation") is not True:
+                self.generative = True
+                main.update(adequate=False, recommendation=None, reason="uncertainty")
+        return [main]
+
+
+# ── the step ─────────────────────────────────────────────────────────────────
+
+def _turn_state(agent, turn_id: str) -> dict:
+    st = getattr(agent, "_native_decision_state", None)
+    if not isinstance(st, dict) or st.get("turn_id") != turn_id:
+        st = agent._native_decision_state = {"turn_id": turn_id, "steps": 0, "attempted": set(),
+                                             "drafts": {}}
+    return st
+
+
+def _refund(agent, s) -> None:
+    """A native step makes no provider call: give back the iteration begin_iteration charged."""
+    s.api_call_count -= 1
+    agent._api_call_count = s.api_call_count
+    try:
+        agent.iteration_budget.refund()
+    except Exception:
+        pass
+
+
+def _unrefund(agent, s) -> None:
+    s.api_call_count += 1
+    agent._api_call_count = s.api_call_count
+    try:
+        agent.iteration_budget.consume()
+    except Exception:
+        pass
+
+
+def _blank_message(content, tool_calls, finish_reason):
+    return SimpleNamespace(content=content, tool_calls=tool_calls, finish_reason=finish_reason,
+                           reasoning=None, reasoning_content=None, reasoning_details=None)
+
+
+def select_native_step(agent, s, run_phase: Callable):
+    """Return an ordinary phase verdict (``action`` break/continue/return) when a native step was
+    selected and executed, else None so the loop proceeds to the provider.
+
+    ``s`` is the loop state; ``run_phase(fn)`` runs a phase helper against it. Execution errors
+    propagate to the loop's normal outer-error handling.
+    """
+    # Settings guard first: off (the default) touches no source, hook, journal or receipt.
+    try:
+        settings = decision_config.for_agent(agent)
+    except Exception:
+        return None
+    if not settings.enabled or not isinstance(s.user_message, str):
+        return None
+    try:
+        if agent.iteration_budget.remaining <= 0:
+            return None
+        from hermes_cli.plugins import has_hook
+        if not has_hook(HOOK):
+            return None
+        turn_id = str(s.turn_id or "")
+        session_id = str(getattr(agent, "session_id", "") or "")
+        if not turn_id or not session_id:
+            return None
+        st = _turn_state(agent, turn_id)
+        if st["steps"] >= MAX_NATIVE_STEPS:
+            return None
+        turn = Turn(s.user_message, turn_id, first=len(s.messages) - 1 == s.current_turn_user_idx,
+                    rows=tuple(copy.deepcopy(s.messages[s.current_turn_user_idx + 1:][-8:])))
+        found = _enumerate(agent, turn, st, settings)
+    except Exception:
+        logger.debug("native step enumeration failed", exc_info=True)
+        return None
+    if found is None:
+        return None
+    step, values, drafted = found
+    point, label = _KINDS[step.kind]
+    label = "bounded_llm_draft" if drafted else label
+    if not settings.includes(point) or not settings.includes(GATE_POINT):
+        # Excluded: the literal original branch, no evaluation and no network.
+        _emit({"schema": "decision_application.v1", "point_id": point, "step_id": step.step_id,
+               "status": "excluded", "fallback": "original", "candidate_source": label}, settings)
+        return None
+    attempt = (step.kind, step.step_id) if step.kind in ("closed_answer", "executor", "yes_no") else (step.kind, step.step_id, step.revision)
+    if attempt in st["attempted"]:
+        return None
+    st["attempted"].add(attempt)
+    st["steps"] += 1
+
+    gate_request, choice_request = _descriptors(step, values, point, label)
+    choice_q = {"type": "choice", "criteria": {f"c{i}": v["description"] for i, v in enumerate(values)}}
+    batch = _Batch(agent, turn_id, step, gate_request, choice_request, settings)
+    n_messages = len(s.messages)
+    state = {"user_message": s.user_message, "context": copy.deepcopy(step.state)}
+    failure: List[BaseException] = []
+
+    def execute(selected):
+        try:
+            _refund(agent, s)
+            if step.kind == "executor":
+                from agent import decision_executor
+                entry = settings.executors[selected["id"]]
+                if entry.get("type") == "hermes":
+                    _unrefund(agent, s)
+                    return None                     # the original Hermes executor: the provider path
+                brief = s.user_message
+                if getattr(agent, "_decision_approach", None):       # code.approach precedes the executor once
+                    brief += f"\n\nStrategy: {agent._decision_approach}"
+                    agent._decision_approach = None
+                model = decision_executor.lane_model(agent, entry, brief=brief, session_id=session_id,
+                                                     turn_id=turn_id)
+                report = decision_executor.run(agent, entry, brief=brief, activity=selected["id"], model=model)
+                selected = {"answer": decision_executor.feedback(report)}
+            if step.kind in ("closed_answer", "executor", "yes_no"):
+                from agent.turn_final_response import finish_text_response
+                s.assistant_message = _blank_message(selected["answer"], None, "stop")
+                s.finish_reason, s.response = "stop", None
+                return run_phase(finish_text_response)
+            from agent.turn_tool_round import run_tool_round
+            calls = [SimpleNamespace(
+                id="call_" + uuid.uuid4().hex, type="function",
+                function=SimpleNamespace(name=c["tool"], arguments=json.dumps(c["args"], sort_keys=True)))
+                for c in selected["calls"]]
+            s.assistant_message = _blank_message(None, calls, "tool_calls")
+            s.finish_reason = "tool_calls"
+            return run_phase(run_tool_round)
+        except BaseException as exc:
+            failure.append(exc)
+            raise
+
+    def current_revision():
+        if getattr(agent, "_interrupt_requested", False) or len(s.messages) != n_messages:
+            return "stale"
+        return step.revision
+
+    def validate(p, value):
+        return p == point and _valid_value(agent, step, drafted, value)
+
+    def authorize(p, value):
+        return (p == point and not getattr(agent, "_interrupt_requested", False)
+                and _valid_value(agent, step, drafted, value))
+
+    from hermes_constants import get_hermes_home
+    consumer = Consumer(journal=_journal(agent), binding=(get_hermes_home().name or "default", session_id, turn_id),
+                        evaluate=batch, admit=lambda: remote_admitted(agent), validate=validate,
+                        authorize=authorize, deadline=settings.timeout_seconds)
+    receipt = consumer.run(
+        point=point, step=step.step_id, revision=step.revision, state=state,
+        question=choice_q, candidate_source=label, values=values, execute=execute,
+        current_revision=current_revision)
+    if failure:
+        _emit({**receipt, "step_id": step.step_id}, settings)
+        raise failure[0]
+    if batch.gate is not None:
+        _emit({"schema": "decision_receipt.v1", "point_id": GATE_POINT, "step_id": step.step_id,
+               "evaluation": batch.gate.get("evaluation"), "adequate": batch.gate.get("adequate"),
+               "recommendation": batch.gate.get("recommendation"), "margin": batch.gate.get("margin"),
+               "latency_ms": batch.gate.get("latency_ms"), "reason": batch.gate.get("reason"),
+               "candidate_source": "code_enum"}, settings)
+    verdict = receipt.pop("outcome", None) if receipt.get("status") == "applied" else None
+    if receipt.get("status") == "applied" and verdict is None:
+        receipt["outcome"] = "original_executor"
+    if batch.generative and receipt.get("status") != "applied":
+        receipt["status"] = "declined"     # gate read the step as generative: original branch
+    _emit({**receipt, "step_id": step.step_id, "candidate_source": label,
+           **({"outcome": "turn_ended" if verdict.action != "continue" else "round_completed"}
+              if verdict is not None else {})}, settings)
+    return verdict
+
+
+def _enumerate(agent, turn: Turn, st: dict, settings):
+    """First valid code-enumerated step, as (step, values, drafted); sources run in code order."""
+    sources = [*(getattr(agent, "_native_step_sources", None) or ()), *_SOURCES]
+    for source in sources:
+        step = source(agent, turn)
+        if step is None:
+            continue
+        drafted = False
+        options = step.options
+        if (not options and step.kind == "tool_plan" and callable(step.draft) and _text(step.step_id, 128)
+                and settings.includes("tool.plan") and remote_admitted(agent)):
+            key = (step.step_id, step.revision)
+            if key not in st["drafts"]:
+                st["drafts"][key] = step.draft(agent, turn)   # one bounded draft per step revision
+                _emit({"schema": "decision_application.v1", "event": "candidate_draft",
+                       "point_id": "tool.plan", "step_id": step.step_id,
+                       "candidate_source": "bounded_llm_draft", "status": "recorded",
+                       "count": len(st["drafts"][key]) if isinstance(st["drafts"][key], list) else 0}, settings)
+            options, drafted = st["drafts"][key], True
+        values = _normalize(agent, step, drafted, options)
+        if values is not None:
+            return step, values, drafted
+    return None
