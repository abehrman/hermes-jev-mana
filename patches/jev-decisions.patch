diff --git a/agent/decision_config.py b/agent/decision_config.py
new file mode 100644
index 00000000..d875ff49
--- /dev/null
+++ b/agent/decision_config.py
@@ -0,0 +1,182 @@
+"""Normal-config decision switch, frozen once per agent/session admission.
+
+Off is the upstream default. No environment or plugin-private parallel switch.
+The disabled state is consumed before invoking hooks, logging or opening journals.
+"""
+from dataclasses import dataclass, replace, field
+import math
+import logging
+
+logger = logging.getLogger(__name__)
+PLUGIN = "jev-mana"
+POINTS = frozenset({"ask.closed", "ask.decision_gate", "route.session", "route.effort",
+                    "skill.pick", "context.pick", "tool.plan", "search.pick", "gui.step",
+                    "approval.triage", "code.approach", "work.executor"})
+
+
+DEFAULT_EXECUTORS = {
+    "create": {"type": "claude-code", "mode": "print", "workdir_policy": "worktree"},
+    "maintain": {"type": "hermes", "mode": "print", "workdir_policy": "in_place"},
+}
+
+
+def merge_executors(base, override):
+    import copy
+    if not isinstance(base, dict) or not isinstance(override, dict):
+        raise ValueError("invalid_executor_map")
+    merged = copy.deepcopy(base)
+    for activity, entry in override.items():
+        if not isinstance(activity, str) or not activity.isidentifier() or not isinstance(entry, dict):
+            raise ValueError("invalid_executor_class")
+        target = {**merged.get(activity, {}), **entry}
+        if target.get("type") not in ("claude-code", "codex", "opencode", "hermes", "command", "mcp"):
+            raise ValueError("invalid_executor_type")
+        if target.get("mode", "print") not in ("print", "tmux", "mcp"):
+            raise ValueError("invalid_executor_mode")
+        if target.get("workdir_policy", "worktree") not in ("worktree", "in_place"):
+            raise ValueError("invalid_workdir_policy")
+        if any(key in target and (not isinstance(target[key], str) or not target[key])
+               for key in ("model", "effort")):
+            raise ValueError("invalid_executor_pin")
+        merged[activity] = target
+    return merged
+
+
+@dataclass(frozen=True)
+class Settings:
+    enabled: bool = False
+    exclude: frozenset = frozenset()
+    margin: float = 0.15
+    timeout_seconds: float = 1.0
+    turn_budget_seconds: float = 5.0
+    receipts: bool = True
+    use_global: bool = True
+    admit_unlabeled: bool = False
+    include: frozenset = frozenset()
+    executors: dict = field(default_factory=lambda: merge_executors({}, DEFAULT_EXECUTORS))
+
+    def includes(self, point):
+        return self.enabled and point not in self.exclude
+
+
+def _master_on(value):
+    """``jev.decisions``: the string ``on`` (or YAML 1.1's boolean for a bare ``on``). Anything else is off."""
+    return value is True or (isinstance(value, str) and value.strip().lower() == "on")
+
+
+def from_config(config, tuning=None):
+    if not isinstance(config, dict):
+        return Settings()
+    plugin = config.get("plugins", {})
+    if not isinstance(plugin, dict):
+        return Settings()
+    enabled = plugin.get("enabled")
+    disabled = plugin.get("disabled", [])
+    entries = plugin.get("entries", {})
+    entry = entries.get(PLUGIN, {}) if isinstance(entries, dict) else {}
+    if (not isinstance(enabled, list) or PLUGIN not in enabled
+            or not isinstance(disabled, list) or PLUGIN in disabled
+            or (isinstance(entry, dict) and entry.get("enabled") is False)):
+        return Settings()
+    values = config.get("jev", {})
+    if not isinstance(values, dict) or not _master_on(values.get("decisions", "off")):
+        return Settings()
+    tuning = tuning if tuning is not None else {}
+    if not isinstance(tuning, dict):
+        return Settings()
+    excluded = tuning.get("exclude") or []
+    margin = tuning.get("margin", 0.15)
+    timeout = tuning.get("timeout_seconds", 1.0)
+    budget = tuning.get("turn_budget_seconds", 5.0)
+    receipts = tuning.get("receipts", True)
+    admit = tuning.get("admit_unlabeled", False)
+    numeric = (margin, timeout, budget)
+    if (not isinstance(excluded, list) or any(not isinstance(x, str) for x in excluded)
+            or any(not isinstance(n, (int, float)) or isinstance(n, bool)
+                   or not math.isfinite(n) for n in numeric)
+            or not 0.01 <= margin <= 1.0 or not 0 < timeout <= 60
+            or not 0 < budget <= 300 or not isinstance(receipts, bool) or not isinstance(admit, bool)):
+        return Settings()
+    if any(point not in POINTS for point in excluded):
+        logger.warning("Unknown Jev exclusion ignored; use registered decision point IDs")
+    try:
+        executors = merge_executors(DEFAULT_EXECUTORS, tuning.get("executors", {}))
+    except ValueError:
+        logger.warning("Invalid Jev executor map; using original Hermes path")
+        return Settings()
+    return Settings(True, frozenset(p for p in excluded if p in POINTS), float(margin),
+                    float(timeout), float(budget), receipts, admit_unlabeled=admit, executors=executors)
+
+
+def merge_tuning(global_values, profile_values):
+    if not isinstance(global_values, dict) or not isinstance(profile_values, dict):
+        raise ValueError("invalid_tuning")
+    if "use_global" in global_values or "include" in global_values:
+        logger.warning("Global Jev tuning ignores use_global and include")
+    if not isinstance(profile_values.get("use_global", True), bool):
+        raise ValueError("invalid_use_global")
+    baseline = {k: v for k, v in global_values.items() if k not in ("use_global", "include")}
+    result = dict(baseline) if profile_values.get("use_global", True) else {}
+    for key in ("margin", "timeout_seconds", "turn_budget_seconds", "receipts", "admit_unlabeled"):
+        if key in profile_values:
+            result[key] = profile_values[key]
+    if "executors" in global_values or "executors" in profile_values:
+        result["executors"] = merge_executors(merge_executors(DEFAULT_EXECUTORS, result.get("executors", {})), profile_values.get("executors", {}))
+    excluded = (result.get("exclude") or [])
+    additions = profile_values.get("exclude") or []
+    included = profile_values.get("include") or []
+    if any(not isinstance(v, list) or any(not isinstance(p, str) for p in v)
+           for v in (excluded, additions, included)):
+        raise ValueError("invalid_point_list")
+    if any(p not in POINTS for p in [*excluded, *additions, *included]):
+        logger.warning("Unknown Jev tuning point ignored; use registered IDs")
+    result["exclude"] = sorted(((set(excluded) | set(additions)) - set(included)) & POINTS)
+    return result
+
+
+def _read_tuning(path):
+    import yaml
+    try:
+        value = yaml.safe_load(path.read_text(encoding="utf-8"))
+    except FileNotFoundError:
+        return {}
+    if value is None:
+        return {}
+    if not isinstance(value, dict):
+        raise ValueError("invalid_tuning_file")
+    return value
+
+
+def load_settings():
+    from hermes_cli.config import load_config_readonly
+    from hermes_cli.profiles import _get_default_hermes_home
+    from hermes_constants import get_hermes_home
+    import yaml
+    config = load_config_readonly()
+    initial = from_config(config)
+    if not initial.enabled:
+        return initial
+    home = get_hermes_home()
+    root = _get_default_hermes_home()
+    try:
+        global_values = _read_tuning(root / "jev_config.yaml")
+        profile_values = _read_tuning(home / "jev_config.yaml") if home != root else {}
+        tuning = merge_tuning(global_values, profile_values)
+    except (OSError, ValueError, yaml.YAMLError):
+        logger.warning("Invalid Jev tuning file; using original Hermes path")
+        return Settings()
+    settings = from_config(config, tuning)
+    return replace(settings, use_global=profile_values.get("use_global", True),
+                   include=frozenset(p for p in (profile_values.get("include") or []) if p in POINTS))
+
+
+def for_agent(agent):
+    settings = getattr(agent, "_decision_settings", None)
+    if settings is None:
+        settings = agent._decision_settings = load_settings()
+        if settings.enabled:
+            logger.info("Jev effective config: use_global=%s exclude=%s include=%s margin=%s timeout=%s turn_budget=%s receipts=%s admit_unlabeled=%s",
+                        settings.use_global, sorted(settings.exclude), sorted(settings.include),
+                        settings.margin, settings.timeout_seconds, settings.turn_budget_seconds, settings.receipts,
+                        settings.admit_unlabeled)
+    return settings
diff --git a/agent/decision_consumer.py b/agent/decision_consumer.py
new file mode 100644
index 00000000..03b68b89
--- /dev/null
+++ b/agent/decision_consumer.py
@@ -0,0 +1,306 @@
+"""Generic bounded host decision consumer, independent of any decision provider.
+
+Candidates, validation, permissions, persistence and effects belong to the host.
+Provider-emitted tool-call identities and sidecars are never rewritten here.
+
+Result contract (``Consumer.run`` return, schema ``decision_application.v1``):
+``status`` is one of applied, declined, replayed, execution_error, policy_denied, stale,
+invalid, outage, uncertainty, budget_skip, budget_timeout, local_privacy_skip,
+privacy_revoked, excluded, journal_unavailable. ``fallback`` is ``none`` after an applied
+decision and ``original`` for every other outcome: the host runs its literal original branch
+with unchanged inputs and model. There is no bespoke fallback lane and no default candidate.
+
+``reconcile_required`` is the one distinction a reviewer must see. It is True for
+``execution_error`` and ``replayed``: a durable claim exists, so the effect may already have
+started. The caller must then take its ORIGINAL executor's canonical reconciliation of that
+in-flight work, never a repeated direct action. The consumer itself never retries it.
+
+The consumer grants nothing. ``authorize`` is the host's own ordinary permission path and
+``execute`` the ordinary execution/persistence pipeline; a decision can only choose among
+candidates those paths already permit and can never overrule a direct owner contract.
+Receipt numbers (confidence, probabilities by candidate position, token counts) are copied
+only as validated finite numbers: never option names, state or raw provider text.
+"""
+from __future__ import annotations
+
+import contextlib
+import copy
+import hashlib
+import json
+import math
+import os
+import sqlite3
+import time
+import uuid
+from pathlib import Path
+
+
+POINTS = frozenset({
+    "ask.closed", "ask.decision_gate", "route.session", "route.effort", "skill.pick",
+    "context.pick", "tool.plan", "search.pick", "gui.step", "approval.triage", "code.approach", "work.executor",
+})
+SOURCES = frozenset({"code_enum", "source_records", "typed_user_options", "bounded_llm_draft"})
+_RESULT_REASONS = frozenset({"uncertainty", "outage", "invalid", "budget_skip", "budget_timeout",
+                             "local_privacy_skip", "privacy_revoked", "excluded", "health_failed"})
+_MAX_STATE_NOTE = 64
+
+
+class Journal:
+    """Durable at-most-once reservation. Crash-after-reserve never repeats effects."""
+
+    def __init__(self, path):
+        self.path = Path(path)
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        os.close(os.open(self.path, os.O_CREAT | os.O_RDWR, 0o600))  # private from creation
+        self.path.chmod(0o600)
+        with self._conn() as conn:
+            conn.execute("CREATE TABLE IF NOT EXISTS decisions "
+                         "(binding TEXT PRIMARY KEY, status TEXT NOT NULL, receipt TEXT NOT NULL)")
+
+    @contextlib.contextmanager
+    def _conn(self):
+        conn = sqlite3.connect(self.path, timeout=1)
+        try:
+            conn.execute("PRAGMA synchronous=FULL")
+            with conn:
+                yield conn
+        finally:
+            conn.close()
+
+    def reserve(self, binding, receipt):
+        """True only for the single caller that creates the row."""
+        with self._conn() as conn:
+            result = conn.execute("INSERT OR IGNORE INTO decisions VALUES (?, ?, ?)",
+                                  (binding, "reserved", json.dumps(receipt, allow_nan=False)))
+            return result.rowcount == 1
+
+    def settle(self, binding, status, receipt):
+        with self._conn() as conn:
+            result = conn.execute("UPDATE decisions SET status=?, receipt=? "
+                                  "WHERE binding=? AND status='reserved'",
+                                  (status, json.dumps(receipt, allow_nan=False), binding))
+            if result.rowcount != 1:
+                raise ValueError("missing_reservation")
+
+    def release(self, binding):
+        """Drop a reservation whose effect provably never started."""
+        with self._conn() as conn:
+            conn.execute("DELETE FROM decisions WHERE binding=? AND status='reserved'", (binding,))
+
+    def read(self, binding):
+        with self._conn() as conn:
+            row = conn.execute("SELECT status,receipt FROM decisions WHERE binding=?", (binding,)).fetchone()
+            return (row[0], json.loads(row[1])) if row else None
+
+
+def _canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False)
+
+
+def _finite(value):
+    ok = isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)
+    return value if ok else None
+
+
+def _tokens(value):
+    value = _finite(value)
+    return int(value) if value is not None and value >= 0 and value == int(value) else None
+
+
+def _diagnostics(result):
+    """Numeric-only diagnostics, so a KPI can count real evaluations and token spend."""
+    unit = _finite(result.get("confidence"))
+    spread = result.get("probabilities")
+    if (not isinstance(spread, (list, tuple)) or len(spread) > 255
+            or any(_finite(p) is None or not 0 <= p <= 1 for p in spread)):
+        spread = None
+    size = _tokens(result.get("batch_size"))
+    return {"confidence": unit if unit is not None and 0 <= unit <= 1 else None,
+            "probabilities": [float(p) for p in spread] if spread is not None else None,
+            "input_tokens": _tokens(result.get("input_tokens")),
+            "output_tokens": _tokens(result.get("output_tokens")),
+            "batch_size": size if size else None}
+
+
+class Consumer:
+    """One per turn; fixed host permission and admission callbacks, no model grants.
+
+    ``source_current`` is an optional host callable that must keep returning True while the
+    candidate source is still valid (revocation); ``admit`` is the privacy/source admission.
+    """
+
+    def __init__(self, *, journal, binding, evaluate, admit, validate, authorize,
+                 clock=None, deadline=1.0, source_current=None):
+        if not isinstance(binding, tuple) or len(binding) != 3 or not all(binding):
+            raise ValueError("scope_binding_required")
+        if not all(callable(f) for f in (evaluate, admit, validate, authorize)):
+            raise ValueError("callbacks_required")
+        if source_current is not None and not callable(source_current):
+            raise ValueError("source_current_not_callable")
+        if (not isinstance(deadline, (int, float)) or isinstance(deadline, bool)
+                or not math.isfinite(deadline) or deadline <= 0):
+            raise ValueError("invalid_deadline")
+        self.journal = journal
+        self.scope = binding
+        self.evaluate = evaluate
+        self.admit = admit
+        self.validate = validate
+        self.authorize = authorize
+        self.clock = clock or time.monotonic
+        self.deadline = deadline
+        self.source_current = source_current
+
+    def run(self, *, point, step, revision, state, question, candidate_source,
+            values, execute, current_revision):
+        """Execute a typed, exact host alternative after a one-time durable claim.
+
+        validate checks ALL candidates before their public descriptions leave.
+        authorize checks the selected value immediately before canonical execution.
+        execute must use the ordinary persistence/execution path, not bypass it.
+        Protected fallback is a local stop, never permission to invoke cloud LLM.
+
+        values[i] is the host candidate for choice option i / score level i. A noul
+        question has exactly one candidate: a True answer applies it, False is "declined".
+        Programmer errors (unknown point, empty values, bad callables) raise ValueError;
+        every runtime failure returns a receipt and never raises.
+        """
+        if point not in POINTS or not isinstance(step, str) or not step:
+            raise ValueError("invalid_point_or_step")
+        if not isinstance(values, list) or not values:
+            raise ValueError("invalid_values")
+        if candidate_source not in SOURCES or not callable(execute) or not callable(current_revision):
+            raise ValueError("invalid_arguments")
+        receipt = {"schema": "decision_application.v1", "point_id": point,
+                   "receipt_id": uuid.uuid4().hex, "recommendation": None,
+                   "applied": None, "status": "invalid", "fallback": "original",
+                   "reconcile_required": False}
+
+        def done(status, fallback=None, **extra):
+            return {**receipt, "status": status, "fallback": fallback or "original", **extra}
+
+        try:
+            snapshot = copy.deepcopy(values)
+            frozen = _canonical(snapshot)
+            binding = hashlib.sha256(_canonical([self.scope, point, step, revision, frozen]).encode()).hexdigest()
+            question = copy.deepcopy(question)
+            state = copy.deepcopy(state)
+        except (TypeError, ValueError, RecursionError):
+            return done("invalid")
+        try:
+            prior = self.journal.read(binding)
+        except Exception:
+            return done("journal_unavailable")
+        if prior:
+            return done("replayed", reconcile_required=True, prior_status=str(prior[0])[:_MAX_STATE_NOTE])
+        if not self._safe_all(point, snapshot):
+            return done("invalid")
+        kind = question.get("type") if isinstance(question, dict) else None
+        size = len(question.get("criteria") or ()) if kind in ("choice", "score") else 1
+        if kind not in ("choice", "score", "noul") or size != len(snapshot):
+            return done("invalid")  # candidates and asked options must correspond one-to-one
+        if not self._clear():
+            return done("local_privacy_skip")
+        started = self._now()
+        request = {"point": point, "question": question, "candidate_source": candidate_source}
+        try:
+            results = self.evaluate(state, [request], admission=self.admit)
+            result = results[0]
+            if not isinstance(result, dict):
+                raise TypeError("result")
+        except Exception:
+            return done("outage")
+        receipt.update(evaluation=result.get("evaluation") if isinstance(result.get("evaluation"), str) else None,
+                       margin=_finite(result.get("margin")), latency_ms=_finite(result.get("latency_ms")),
+                       **_diagnostics(result))
+        if (result.get("schema") != "decision_receipt.v1" or result.get("point_id") != point
+                or result.get("candidate_source") != candidate_source or result.get("applied") is not None):
+            return done("invalid")
+        recommendation = result.get("recommendation")
+        if result.get("adequate") is not True or result.get("evaluation") != "jev":
+            reason = result.get("reason")
+            status = reason if reason in _RESULT_REASONS else "invalid"
+            return done(status)
+        if kind == "noul":
+            if not isinstance(recommendation, bool):
+                return done("invalid")
+            receipt["recommendation"] = recommendation
+            index = 0
+        else:
+            if (not isinstance(recommendation, int) or isinstance(recommendation, bool)
+                    or not 0 <= recommendation < len(snapshot)):
+                return done("invalid")
+            receipt["recommendation"] = index = recommendation
+        if not self._fresh(started, revision, current_revision, values, frozen):
+            return done("stale")
+        if not self._clear():
+            return done("privacy_revoked")
+        if kind == "noul" and recommendation is False:
+            return done("declined")
+        selected = snapshot[index]
+        if not self._safe_all(point, [selected]) or not self._allowed(point, selected):
+            return done("policy_denied")
+        receipt["status"] = "reserved"
+        try:
+            reserved = self.journal.reserve(binding, receipt)
+        except Exception:
+            return done("journal_unavailable")
+        if not reserved:
+            return done("replayed", reconcile_required=True)
+        # Persisted reservation precedes execution. No retry after a crash or error.
+        if not self._fresh(started, revision, current_revision, values, frozen, deadline=False) or not self._clear():
+            # Nothing ran: give the claim back so a later, current decision can proceed.
+            try:
+                self.journal.release(binding)
+            except Exception:
+                return done("journal_unavailable", reconcile_required=True)
+            return done("privacy_revoked" if not self._clear() else "stale")
+        try:
+            outcome = execute(copy.deepcopy(selected))
+        except Exception:
+            receipt.update(status="execution_error", reconcile_required=True)
+            return {**receipt, **self._settle(binding, receipt)}
+        receipt.update(status="applied", applied=index, fallback="none")
+        return {**receipt, **self._settle(binding, receipt), "outcome": outcome}
+
+    def _settle(self, binding, receipt):
+        try:
+            self.journal.settle(binding, receipt["status"], receipt)
+            return {"settled": True}
+        except Exception:
+            # The claim row stays 'reserved', so a replay still reconciles instead of re-running.
+            return {"settled": False}
+
+    def _now(self):
+        try:
+            value = self.clock()
+        except Exception:
+            return None
+        return float(value) if _finite(value) is not None else None
+
+    def _fresh(self, started, revision, current_revision, values, frozen, deadline=True):
+        try:
+            if deadline:
+                now = self._now()
+                if started is None or now is None or now - started > self.deadline or now < started:
+                    return False
+            return current_revision() == revision and _canonical(values) == frozen
+        except Exception:
+            return False
+
+    def _safe_all(self, point, candidates):
+        try:
+            return all(self.validate(point, copy.deepcopy(c)) is True for c in candidates)
+        except Exception:
+            return False
+
+    def _allowed(self, point, selected):
+        try:
+            return self.authorize(point, copy.deepcopy(selected)) is True
+        except Exception:
+            return False
+
+    def _clear(self):
+        try:
+            return self.admit() is True and (self.source_current is None or self.source_current() is True)
+        except Exception:
+            return False
diff --git a/agent/decision_executor.py b/agent/decision_executor.py
