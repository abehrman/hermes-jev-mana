new file mode 100644
index 00000000..d5387a23
--- /dev/null
+++ b/agent/decision_seams.py
@@ -0,0 +1,318 @@
+"""Generic, off-by-default host decision seam.
+
+A host callsite enumerates its own candidates (each with a short public ``description``),
+supplies ``validate``/``authorize``/``execute`` and calls :func:`decide`. One
+``select_agent_step`` hook round trip reads every request of the batch; the plugin that answers
+owns the question wording and the evaluator. The host keeps source validation, permission,
+the durable at-most-once claim (``decision_consumer``) and the effect itself.
+
+Off (the upstream default), an excluded point or no registered evaluator: :func:`active` is
+None, so the callsite never builds candidates, invokes a hook, opens a journal or writes a
+receipt, and its original branch runs with its original inputs. Every unusable enabled outcome
+(outage, timeout, budget, near tie, invalid, stale, replayed, privacy, policy) is
+``Outcome.applied == False``: the literal original branch, never a substitute candidate.
+``Outcome.reconcile`` marks an effect that may already have started; the caller reconciles it
+through its original executor and never repeats it.
+
+Hook contracts (``hermes_cli.plugins.VALID_HOOKS``):
+
+* ``select_agent_step(requests, state, admission, source, session_id, turn_id, deadline,
+  budget, margin) -> list[reading]``. ``requests[i]`` is ``{"point", "kind", "candidate_source",
+  "step", "options": [descriptions]}`` (``kind`` choice|noul) and its public state is
+  ``state["r<i>"]``. A reading is ``decision_receipt.v1`` with ``evaluation``, ``adequate``,
+  ``recommendation`` (option index, or bool for noul), ``margin``. ``admission()`` must be
+  rechecked at the send boundary.
+* ``decision_candidates(point, context) -> list[dict]``: optional proposals for points whose
+  domain is plugin policy (e.g. lane tiers). The host validates every proposal; a proposal it
+  cannot verify is dropped, never trusted.
+* ``agent_decision_receipt(receipt)``: public numeric/status fields only.
+"""
+from __future__ import annotations
+
+import concurrent.futures
+import contextvars
+import copy
+import logging
+import math
+import time
+from pathlib import Path
+from dataclasses import dataclass, field
+from typing import Any, Callable, Dict, List, Optional, Sequence
+
+from agent import decision_config
+from agent.decision_consumer import Consumer, Journal
+
+logger = logging.getLogger("agent.decision_seams")
+
+HOOK = "select_agent_step"
+RECEIPT_HOOK = "agent_decision_receipt"
+CANDIDATES_HOOK = "decision_candidates"
+SOURCE_LABEL = "hermes.core.native"
+MAX_OPTIONS = 32
+MAX_DESCRIPTION = 300
+PUBLIC_FIELDS = ("schema", "event", "point_id", "step_id", "receipt_id", "status", "fallback",
+                 "recommendation", "applied", "evaluation", "adequate", "margin", "latency_ms",
+                 "candidate_source", "reason", "count", "outcome", "reconcile_required",
+                 "confidence", "probabilities", "input_tokens", "output_tokens", "batch_size")
+
+
+# ── gate ─────────────────────────────────────────────────────────────────────
+
+def settings_for(agent=None):
+    """Frozen per-agent settings; agent-less callsites read the normal config each time."""
+    try:
+        return decision_config.for_agent(agent) if agent is not None else decision_config.load_settings()
+    except Exception:
+        logger.debug("decision settings unavailable", exc_info=True)
+        return decision_config.Settings()
+
+
+def active(agent, point: str, settings=None):
+    """Settings when ``point`` may be decided now, else None. Off is checked before any hook
+    lookup, so the disabled path never touches the plugin manager."""
+    settings = settings if settings is not None else settings_for(agent)
+    if not settings.includes(point):
+        return None
+    try:
+        from hermes_cli.plugins import has_hook
+        return settings if has_hook(HOOK) else None
+    except Exception:
+        return None
+
+
+def remote_admitted(agent, payload=None) -> bool:
+    """Public only on positive evidence. A host surface may set ``agent._native_remote_admission``
+    (callable -> True); otherwise the installed source-label contract (``agent.jev_source``) must
+    exist and find no protected label. With neither, the source is unknown and stays local."""
+    try:
+        authority = getattr(agent, "_native_remote_admission", None) if agent is not None else None
+        if callable(authority):
+            ok = authority() is True
+        else:
+            try:
+                from agent import jev_source
+            except ImportError:
+                # Stock host: no source-label authority exists. Unlabeled content is admitted only when
+                # the operator opted in (``admit_unlabeled`` in jev_config.yaml, default false); the
+                # evaluator's local privacy scan and the agent flags below still apply.
+                jev_source = None
+            if jev_source is None:
+                ok = settings_for(agent).admit_unlabeled is True
+            else:
+                # ``agent`` can be a namespace package spanning several checkouts: only a source-label
+                # contract installed beside this module counts, never one leaking in from another tree.
+                if Path(jev_source.__file__).resolve().parent != Path(__file__).resolve().parent:
+                    return False
+                ok = jev_source.current_protected(payload) is False
+        return (ok and not getattr(agent, "_persist_disabled", False)
+                and not getattr(agent, "_jev_local_only", False)
+                and not getattr(agent, "_jev_protected", False)
+                and getattr(agent, "_jev_privacy", "") not in ("private", "protected", "local-only"))
+    except Exception:
+        return False
+
+
+# ── transport ────────────────────────────────────────────────────────────────
+
+def call_hook(name: str, wait: float, **kwargs):
+    """Invoke a plugin hook with a hard wall-clock bound; a late result is discarded."""
+    from hermes_cli.plugins import invoke_hook
+    ctx = contextvars.copy_context()
+    pool = concurrent.futures.ThreadPoolExecutor(max_workers=1)
+    try:
+        return pool.submit(ctx.run, lambda: invoke_hook(name, **kwargs)).result(timeout=wait + 0.25)
+    finally:
+        pool.shutdown(wait=False)
+
+
+def emit(receipt: Dict[str, Any], settings) -> None:
+    if not settings.receipts:
+        return
+    try:
+        from hermes_cli.plugins import invoke_hook
+        invoke_hook(RECEIPT_HOOK, receipt={k: receipt[k] for k in PUBLIC_FIELDS if k in receipt})
+    except Exception:
+        logger.debug("decision receipt hook failed", exc_info=True)
+
+
+def proposals(point: str, settings, **context) -> List[Dict[str, Any]]:
+    """Plugin-proposed candidates for ``point`` (unvalidated: the caller validates each)."""
+    try:
+        replies = call_hook(CANDIDATES_HOOK, settings.timeout_seconds, point=point, context=context)
+    except Exception:
+        return []
+    out = []
+    for reply in replies or ():
+        if isinstance(reply, list):
+            out.extend(r for r in reply if isinstance(r, dict))
+    return out[:MAX_OPTIONS]
+
+
+def readings_ok(results, count: int) -> bool:
+    return (isinstance(results, list) and len(results) == count
+            and all(isinstance(r, dict) and "evaluation" in r and "adequate" in r for r in results))
+
+
+# ── decide ───────────────────────────────────────────────────────────────────
+
+@dataclass
+class Request:
+    """One host decision. ``candidates[i]["description"]`` is the only text that may leave."""
+    point: str
+    step: str
+    revision: str
+    candidates: List[Dict[str, Any]]
+    execute: Callable[[Dict[str, Any]], Any]
+    kind: str = "choice"                    # choice: pick one; noul: apply the single candidate?
+    source: str = "code_enum"
+    state: Dict[str, Any] = field(default_factory=dict)
+    validate: Callable[[Dict[str, Any]], bool] = lambda value: True
+    authorize: Callable[[Dict[str, Any]], bool] = lambda value: True
+    guards: str = ""                        # gate requests: the point this free-form gate guards
+    requires: Optional[int] = None          # index of the gate request that must apply first
+
+
+@dataclass
+class Outcome:
+    applied: bool = False
+    index: Optional[int] = None
+    value: Any = None
+    status: str = "original"
+    reconcile: bool = False
+
+
+def _shape_ok(request: Request) -> bool:
+    count = len(request.candidates) if isinstance(request.candidates, list) else 0
+    if request.kind == "noul" and count != 1 or request.kind == "choice" and not 2 <= count <= MAX_OPTIONS:
+        return False
+    return all(isinstance(c, dict) and isinstance(c.get("description"), str)
+               and c["description"].strip() and len(c["description"]) <= MAX_DESCRIPTION
+               for c in request.candidates)
+
+
+def _journal(agent) -> Journal:
+    journal = getattr(agent, "_native_decision_journal", None) if agent is not None else None
+    if journal is None:
+        from hermes_constants import get_hermes_home
+        journal = Journal(get_hermes_home() / "decisions" / "journal.sqlite")
+        if agent is not None:
+            agent._native_decision_journal = journal
+    return journal
+
+
+def _spend(agent, turn_id: str, settings, seconds: float = 0.0) -> float:
+    """Seconds of the per-turn evaluation budget left after charging ``seconds``."""
+    ledger = getattr(agent, "_decision_budget", None) if agent is not None else None
+    if not isinstance(ledger, dict) or ledger.get("turn_id") != turn_id:
+        ledger = {"turn_id": turn_id, "spent": 0.0}
+        if agent is not None:
+            agent._decision_budget = ledger
+    ledger["spent"] += max(0.0, seconds)
+    return settings.turn_budget_seconds - ledger["spent"]
+
+
+def _unusable(request: Request, status: str, settings, turn_id: str) -> Outcome:
+    emit({"schema": "decision_application.v1", "point_id": request.point, "step_id": request.step,
+          "status": status, "fallback": "original", "candidate_source": request.source}, settings)
+    return Outcome(status=status)
+
+
+def decide(agent, requests: Sequence[Request], *, session_id: str, turn_id: str,
+           settings=None, payload=None) -> List[Outcome]:
+    """Decide a batch of independent host requests with one evaluator round trip."""
+    settings = settings if settings is not None else settings_for(agent)
+    out: List[Optional[Outcome]] = [None] * len(requests)
+    live: List[int] = []
+    for i, request in enumerate(requests):
+        if active(agent, request.point, settings) is None:
+            out[i] = Outcome(status="excluded") if settings.enabled else Outcome(status="disabled")
+            if settings.enabled:
+                _unusable(request, "excluded", settings, turn_id)
+        elif not session_id or not turn_id or not _shape_ok(request):
+            out[i] = _unusable(request, "invalid", settings, turn_id)
+        elif _spend(agent, turn_id, settings) <= 0:
+            out[i] = _unusable(request, "budget_skip", settings, turn_id)
+        else:
+            live.append(i)
+    if not live:
+        return out  # type: ignore[return-value]
+    admit = lambda: remote_admitted(agent, payload)  # noqa: E731
+    descriptors = [{"point": requests[i].point, "kind": requests[i].kind, "candidate_source": requests[i].source,
+                    "step": requests[i].step, "options": [c["description"] for c in requests[i].candidates],
+                    **({"for": requests[i].guards} if requests[i].guards else {})}
+                   for i in live]
+    state = {f"r{n}": copy.deepcopy(requests[i].state) for n, i in enumerate(live)}
+    started = time.monotonic()
+    readings = None
+    # Candidates are validated before any description can leave the host.
+    valid = [all(_true(requests[i].validate, c) for c in requests[i].candidates) for i in live]
+    if all(valid) and admit():
+        try:
+            replies = call_hook(HOOK, settings.timeout_seconds, requests=descriptors, state=state, admission=admit,
+                                source=SOURCE_LABEL, session_id=session_id, turn_id=turn_id,
+                                deadline=settings.timeout_seconds, budget=settings.turn_budget_seconds,
+                                margin=settings.margin)
+            readings = next((r for r in replies or () if readings_ok(r, len(live))), None)
+        except Exception:
+            readings = None
+    _spend(agent, turn_id, settings, time.monotonic() - started)
+    for n, i in enumerate(live):
+        request = requests[i]
+        if not valid[n]:
+            out[i] = _unusable(request, "invalid", settings, turn_id)
+            continue
+        if request.requires is not None and not (out[request.requires] and out[request.requires].applied):
+            out[i] = _unusable(request, "gate_declined", settings, turn_id)   # gate first: original
+            continue
+        out[i] = _apply(agent, request, readings[n] if readings else None, admit, settings, session_id, turn_id)
+    return out  # type: ignore[return-value]
+
+
+def _true(fn, value) -> bool:
+    try:
+        return fn(copy.deepcopy(value)) is True
+    except Exception:
+        return False
+
+
+def _gated(reading, kind: str, settings):
+    """Enforce the configured near-tie margin for choices, whatever the evaluator's own bar."""
+    if not isinstance(reading, dict) or kind != "choice" or reading.get("adequate") is not True:
+        return reading
+    margin = reading.get("margin")
+    ok = isinstance(margin, (int, float)) and not isinstance(margin, bool) and math.isfinite(margin)
+    if ok and margin >= settings.margin:
+        return reading
+    return {**reading, "adequate": False, "recommendation": None, "reason": "uncertainty"}
+
+
+def _apply(agent, request: Request, reading, admit, settings, session_id: str, turn_id: str) -> Outcome:
+    from hermes_constants import get_hermes_home
+    question = {"type": request.kind,
+                "criteria": ({f"c{i}": c["description"] for i, c in enumerate(request.candidates)}
+                             if request.kind == "choice" else {"true": request.candidates[0]["description"]})}
+    reading = _gated(reading, request.kind, settings)
+
+    def evaluate(_state, _requests, admission=None):
+        if reading is None:
+            raise RuntimeError("no_valid_reading")
+        return [reading]
+
+    picked: Dict[str, Any] = {}
+
+    def execute(value):
+        picked["value"] = value
+        return request.execute(value)
+
+    consumer = Consumer(journal=_journal(agent), binding=(get_hermes_home().name or "default", session_id, turn_id),
+                        evaluate=evaluate, admit=admit, validate=lambda p, v: _true(request.validate, v),
+                        authorize=lambda p, v: _true(request.authorize, v), deadline=settings.timeout_seconds)
+    receipt = consumer.run(point=request.point, step=request.step, revision=request.revision, state=None,
+                           question=question, candidate_source=request.source,
+                           values=copy.deepcopy(request.candidates), execute=execute,
+                           current_revision=lambda: request.revision)
+    outcome = receipt.pop("outcome", None)
+    emit({**receipt, "step_id": request.step, "candidate_source": request.source}, settings)
+    if receipt.get("status") != "applied":
+        return Outcome(status=str(receipt.get("status")), reconcile=bool(receipt.get("reconcile_required")))
+    return Outcome(applied=True, index=receipt.get("applied"), value=outcome, status="applied")
diff --git a/agent/decision_sources.py b/agent/decision_sources.py
new file mode 100644
index 00000000..e9d1ee1d
--- /dev/null
+++ b/agent/decision_sources.py
@@ -0,0 +1,258 @@
+"""Host candidate sources and effects for the decision callsites.
+
+Each function is called from one existing core callsite and returns that callsite's ORIGINAL
+inputs unchanged unless a decision was applied. Candidates come from host sources only (skill
+catalog, the provider's own prefetch text, the tool's actual result, supported effort levels,
+host-validated lane proposals); effects run through the host's ordinary machinery (skill
+loader, canonical user-row composition, the tool result before it enters context, the agent
+constructor). Question wording and evaluation live in the plugin behind ``decision_seams``.
+Selections are all-or-nothing: one unusable record keeps the whole original value.
+"""
+from __future__ import annotations
+
+import hashlib
+import ipaddress
+import json
+import re
+import urllib.parse
+from typing import Any, Dict, List, Mapping, Optional, Tuple
+
+from agent import decision_seams as seams
+
+MAX_SKILLS = 24
+CODE_APPROACHES = (
+    ("modify_in_place", "Modify the existing code in place, where the behaviour already lives."),
+    ("new_module", "Add a new module or file for the behaviour and wire it into the existing code."),
+    ("reuse_existing", "Reuse an existing helper, library or command instead of writing new logic."),
+)
+MAX_SEGMENTS = 16
+MAX_RESULTS = 20
+_NAME = re.compile(r"^[A-Za-z0-9][\w./:@+-]{0,127}$")
+
+
+def _ids(agent, turn_id) -> Tuple[str, str]:
+    return str(getattr(agent, "session_id", "") or ""), str(turn_id or "")
+
+
+def public_url(url: Any) -> bool:
+    """http(s), no credentials, a globally routable or public DNS host."""
+    try:
+        parts = urllib.parse.urlsplit(str(url))
+        host = (parts.hostname or "").lower()
+        if parts.scheme not in ("http", "https") or not host or parts.username or parts.password:
+            return False
+        try:
+            return ipaddress.ip_address(host.strip("[]")).is_global
+        except ValueError:
+            return "." in host and not host.endswith((".local", ".internal", ".lan", ".localhost"))
+    except Exception:
+        return False
+
+
+# ── skill.pick + context.pick (turn_context, before canonical user-row insertion) ──
+
+def _skill_rows() -> List[Dict[str, Any]]:
+    from agent.skill_utils import TIER_LOCAL
+    from tools.skills_tool import _skill_catalog
+    rows = [r for r in _skill_catalog() if r.get("tier") == TIER_LOCAL and r.get("load_name")
+            and r.get("description") and _NAME.match(str(r["load_name"]))]
+    return sorted(rows, key=lambda r: r["load_name"])
+
+
+def _load_skill(name: str, task_id) -> str:
+    from agent.skill_commands import _disabled_skill_names, _load_skill_blocks, _load_skill_payload
+    _loaded, missing, _disabled, blocks = _load_skill_blocks(
+        [name], lambda ident: _load_skill_payload(ident, task_id=task_id),
+        lambda n: f'[The "{n}" skill was loaded for this turn. Follow its instructions where they '
+                  "apply to the user's request.]",
+        task_id, disabled_names=_disabled_skill_names(), disabled_as_missing=True)
+    if missing or not blocks:
+        raise RuntimeError("skill_not_loaded")
+    return "\n\n".join(blocks)
+
+
+def segments(text: str) -> Optional[List[str]]:
+    parts = [p.strip() for p in re.split(r"\n\s*\n", text or "") if p.strip()]
+    return parts if 1 <= len(parts) <= MAX_SEGMENTS else None
+
+
+def apply_turn_context(agent, *, user_text: str, ext_prefetch_cache: str, plugin_user_context: str,
+                       turn_id) -> Tuple[str, str]:
+    """(prefetch, plugin context) for this turn's user row. New context only; history untouched."""
+    settings = seams.settings_for(agent)
+    skill_on = seams.active(agent, "skill.pick", settings)
+    context_on = seams.active(agent, "context.pick", settings)
+    if not (skill_on or context_on or seams.active(agent, "code.approach", settings)) or not user_text:
+        return ext_prefetch_cache, plugin_user_context
+    try:
+        requests: List[seams.Request] = []
+        loaded: Dict[str, str] = {}
+        rows = _skill_rows() if skill_on else []
+        if 1 <= len(rows) <= MAX_SKILLS:
+            allowed = {r["load_name"] for r in rows}
+            candidates = [{"description": "No skill is needed.", "skill": None}] + [
+                {"description": str(r["description"])[:300], "skill": r["load_name"]} for r in rows]
+
+            def load(value):
+                if value["skill"] is not None:
+                    loaded["text"] = _load_skill(value["skill"], getattr(agent, "session_id", None))
+                return value["skill"]
+            requests.append(seams.Request(
+                point="skill.pick", step="skill.pick", revision=str(turn_id), candidates=candidates,
+                source="source_records", state={"task": user_text}, execute=load,
+                validate=lambda v: v.get("skill") is None or v.get("skill") in allowed))
+        approach: Dict[str, str] = {}
+        if seams.active(agent, "code.approach", settings) and seams.active(agent, "ask.decision_gate", settings):
+            gate = len(requests)
+            requests.append(seams.Request(
+                point="ask.decision_gate", step="code.approach.gate", revision=str(turn_id), kind="noul",
+                candidates=[{"description": "Proceed with a code strategy choice."}], guards="code.approach",
+                state={"ask": user_text}, execute=lambda v: True))
+            requests.append(seams.Request(
+                point="code.approach", step="code.approach", revision=str(turn_id), requires=gate,
+                candidates=[{"description": text, "approach": key} for key, text in CODE_APPROACHES],
+                state={"ask": user_text}, execute=lambda v: approach.__setitem__("text", v["description"]),
+                validate=lambda v: v.get("approach") in dict(CODE_APPROACHES)))
+        parts = segments(ext_prefetch_cache) if context_on and ext_prefetch_cache else None
+        keep: Dict[int, bool] = {}
+        for n, part in enumerate(parts or ()):
+            requests.append(seams.Request(
+                point="context.pick", step=f"context.pick:m{n}", revision=str(turn_id), kind="noul",
+                candidates=[{"description": "Keep this retrieved record in the turn's context.", "record": n}],
+                source="source_records", state={"query": user_text, "record": part},
+                execute=lambda v: keep.__setitem__(v["record"], True)))
+        if not requests:
+            return ext_prefetch_cache, plugin_user_context
+        session_id, turn = _ids(agent, turn_id)
+        outcomes = seams.decide(agent, requests, session_id=session_id, turn_id=turn, settings=settings,
+                                payload=user_text)
+        by_point: Dict[str, list] = {}
+        for request, outcome in zip(requests, outcomes):
+            by_point.setdefault(request.point, []).append(outcome)
+        if by_point.get("skill.pick", [None])[0] is not None and by_point["skill.pick"][0].applied and loaded.get("text"):
+            plugin_user_context = (plugin_user_context + "\n\n" if plugin_user_context else "") + loaded["text"]
+        if approach.get("text") and (by_point.get("code.approach") or [None])[0].applied:
+            agent._decision_approach = approach["text"]
+            plugin_user_context = ((plugin_user_context + "\n\n" if plugin_user_context else "")
+                                   + f"[Strategy selected for this turn: {approach['text']} You write the code.]")
+        ctx = by_point.get("context.pick") or []
+        # Declined means "drop"; anything else unusable keeps the original prefetch whole.
+        if parts and ctx and all(o.applied or o.status == "declined" for o in ctx):
+            ext_prefetch_cache = "\n\n".join(p for n, p in enumerate(parts) if keep.get(n))
+        return ext_prefetch_cache, plugin_user_context
+    except Exception:
+        return ext_prefetch_cache, plugin_user_context
+
+
+# ── search.pick (the tool's actual result, before it enters context) ──────────
+
+def search_pick(agent, *, tool_name: str, args: Any, result: Any, tool_call_id: Optional[str]) -> Any:
+    if tool_name != "web_search" or not isinstance(result, str) or not isinstance(args, Mapping):
+        return result
+    settings = seams.settings_for(agent)
+    if not seams.active(agent, "search.pick", settings):
+        return result
+    try:
+        doc = json.loads(result)
+        items = doc["data"]["web"]
+        if (not doc.get("success") or not isinstance(items, list) or not 2 <= len(items) <= MAX_RESULTS
+                or not all(isinstance(i, dict) and public_url(i.get("url")) for i in items)):
+            return result
+        query = str(args.get("query") or "")
+        keep: Dict[int, bool] = {}
+        requests = [seams.Request(
+            point="search.pick", step=f"search.pick:r{n}", revision=str(tool_call_id or ""), kind="noul",
+            candidates=[{"description": "Keep this search result for reading.", "result": n}],
+            source="source_records",
+            state={"query": query, "result": {k: str(item.get(k) or "") for k in ("title", "url", "description")}},
+            execute=lambda v: keep.__setitem__(v["result"], True)) for n, item in enumerate(items)]
+        session_id = str(getattr(agent, "session_id", "") or "")
+        turn = str(getattr(agent, "_current_turn_id", "") or tool_call_id or "")
+        outcomes = seams.decide(agent, requests, session_id=session_id, turn_id=turn, settings=settings,
+                                payload=query)
+        if not all(o.applied or o.status == "declined" for o in outcomes) or not keep:
+            return result
+        new = dict(doc, data=dict(doc["data"], web=[it for n, it in enumerate(items) if keep.get(n)],
+                                  selection={"kept": len(keep), "of": len(items)}))
+        return json.dumps(new, ensure_ascii=False)
+    except Exception:
+        return result
+
+
+# ── route.session + route.effort (before the agent and its client exist) ──────
+
+def route_kwargs(kwargs: Mapping[str, Any], *, task: str, model_pinned: bool, effort_pinned: bool,
+                 session_id: str = "") -> Dict[str, Any]:
+    """Return ``kwargs`` with ``model``/``reasoning_config`` decided, else a plain copy.
+
+    Lanes stay on the configured provider and credentials (a proposal for another provider is
+    dropped), so no runtime re-resolution happens here. Explicit pins skip their decision."""
+    out = dict(kwargs)
+    settings = seams.settings_for(None)
+    if not task or not (seams.active(None, "route.session", settings) or seams.active(None, "route.effort", settings)):
+        return out
+    try:
+        from agent.reasoning_effort import route_supported_efforts
+        provider, model = str(out.get("provider") or ""), str(out.get("model") or "")
+        turn = "route:" + hashlib.sha256(f"{session_id}\0{task}".encode()).hexdigest()[:24]
+        sid = session_id or turn
+        if not model_pinned and seams.active(None, "route.session", settings) and provider and model:
+            offered = [p for p in seams.proposals("route.session", settings, provider=provider, model=model)
+                       if p.get("provider") == provider and isinstance(p.get("model"), str)
+                       and _NAME.match(p["model"]) and isinstance(p.get("description"), str)]
+            text = {p["model"]: p["description"] for p in offered}
+            lanes = list(dict.fromkeys([model] + [p["model"] for p in offered]))
+            text.setdefault(model, "The currently configured lane for this session.")
+            if len(lanes) < 2:
+                # Prerequisite missing: no configured lane on this provider. Visible, original lane.
+                seams.emit({"schema": "decision_application.v1", "point_id": "route.session", "step_id": "route.session",
+                            "status": "prerequisite_missing", "fallback": "original", "candidate_source": "code_enum"},
+                           settings)
+            if len(lanes) >= 2 and all(text.get(m) for m in lanes):
+                picked: Dict[str, str] = {}
+                outcome = seams.decide(None, [seams.Request(
+                    point="route.session", step="route.session", revision=turn,
+                    candidates=[{"description": text[m][:300], "model": m} for m in lanes],
+                    state={"task": task}, execute=lambda v: picked.__setitem__("model", v["model"]),
+                    validate=lambda v: v.get("model") in lanes)], session_id=sid, turn_id=turn,
+                    settings=settings, payload=task)[0]
+                if outcome.applied and picked.get("model"):
+                    out["model"] = model = picked["model"]
+        levels = list(route_supported_efforts(provider, model))
+        if not effort_pinned and seams.active(None, "route.effort", settings) and len(levels) >= 2:
+            chosen: Dict[str, str] = {}
+            outcome = seams.decide(None, [seams.Request(
+                point="route.effort", step="route.effort", revision=turn + ":" + model,
+                candidates=[{"description": f"Reasoning effort {lvl}", "effort": lvl} for lvl in levels],
+                state={"task": task}, execute=lambda v: chosen.__setitem__("effort", v["effort"]),
+                validate=lambda v: v.get("effort") in levels)], session_id=sid, turn_id=turn,
+                settings=settings, payload=task)[0]
+            if outcome.applied and chosen.get("effort"):
+                out["reasoning_config"] = {**(out.get("reasoning_config") or {}), "enabled": True,
+                                           "effort": chosen["effort"]}
+        return out
+    except Exception:
+        return dict(kwargs)
+
+
+# ── approval.triage (before the guardian; can never approve) ──────────────────
+
+def approval_triage(command: str, description: str, pattern_key: str, session_key: str) -> Optional[str]:
+    """"escalate" (ask the person) or None (the existing guardian path, unchanged)."""
+    settings = seams.settings_for(None)
+    if not seams.active(None, "approval.triage", settings):
+        return None
+    try:
+        turn = "approval:" + hashlib.sha256(f"{session_key}\0{pattern_key}\0{command}".encode()).hexdigest()[:24]
+        picked: Dict[str, str] = {}
+        outcome = seams.decide(None, [seams.Request(
+            point="approval.triage", step="approval.triage", revision=turn,
+            candidates=[{"description": "A person should decide whether this command runs.", "effect": "ask_person"},
+                        {"description": "The existing automated review can judge this command.", "effect": "defer"}],
+            state={"command": command, "description": description, "category": pattern_key},
+            execute=lambda v: picked.__setitem__("effect", v["effect"]),
+            validate=lambda v: v.get("effect") in ("ask_person", "defer"))],
+            session_id=str(session_key or turn), turn_id=turn, settings=settings, payload=command)[0]
+        return "escalate" if outcome.applied and picked.get("effect") == "ask_person" else None
+    except Exception:
+        return None
