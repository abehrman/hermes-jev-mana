index 00000000..0cb223b0
--- /dev/null
+++ b/agent/decision_executor.py
@@ -0,0 +1,164 @@
+"""Host adapter for ``work.executor``: run a configured executor class for one turn.
+
+The executor map (``decision_config.Settings.executors``) is operator configuration; a
+decision only picks a class from it. This module owns prerequisites and the effect: the
+executable must resolve, the agent must already hold local command permission (``terminal``),
+and ``worktree`` classes need a git checkout. Anything missing makes the class unready, so the
+turn keeps its original Hermes branch. ``hermes`` is the original executor and never spawns.
+
+Supported here: ``claude-code``/``codex``/``opencode`` in ``print`` mode and ``command`` (an
+operator-configured argv). ``tmux`` mode and ``mcp`` executors have no host adapter yet and
+are always unready. The executor's own model is the class's ``model`` pin when set, else the
+executor default; this module never chooses a model and never routes its own runs.
+"""
+from __future__ import annotations
+
+import os
+import re
+import subprocess
+import tempfile
+import uuid
+from pathlib import Path
+from typing import Any, Dict, List, Optional
+
+MAX_FEEDBACK = 4000
+TIMEOUT_SECONDS = 1800
+_ARGV = {
+    "claude-code": ("claude", lambda brief, model: ["-p", brief] + (["--model", model] if model else [])),
+    "codex": ("codex", lambda brief, model: ["exec", brief] + (["--model", model] if model else [])),
+    "opencode": ("opencode", lambda brief, model: ["run", brief] + (["--model", model] if model else [])),
+}
+_PATHISH = re.compile(r"[\w./-]+\.[A-Za-z0-9]{1,8}\b|[\w-]+/[\w./-]+")
+
+
+def _locate(name: str) -> Optional[str]:
+    from hermes_platform.resolver.core import locate_command
+    found = locate_command(name)
+    return found.command[0] if found.found and found.command else None
+
+
+def _git_root(cwd: str) -> Optional[str]:
+    try:
+        done = subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel"], capture_output=True,
+                              text=True, timeout=10)
+    except (OSError, subprocess.SubprocessError):
+        return None
+    return (done.stdout.strip() or None) if done.returncode == 0 else None
+
+
+def _program(entry: Dict[str, Any]) -> Optional[List[str]]:
+    kind = entry.get("type")
+    if kind in _ARGV:
+        path = _locate(_ARGV[kind][0])
+        return [path] if path else None
+    if kind == "command":
+        argv = entry.get("command")
+        if isinstance(argv, list) and argv and all(isinstance(a, str) and a for a in argv):
+            path = _locate(argv[0])
+            return [path, *argv[1:]] if path else None
+    return None
+
+
+def ready(agent, entry) -> bool:
+    """True when this class can run now; ``hermes`` (the original executor) always can."""
+    if not isinstance(entry, dict):
+        return False
+    if entry.get("type") == "hermes":
+        return True
+    if entry.get("mode", "print") != "print" or "terminal" not in (getattr(agent, "valid_tool_names", None) or ()):
+        return False
+    if _program(entry) is None:
+        return False
+    cwd = getattr(agent, "session_cwd", None) or os.getcwd()
+    return entry.get("workdir_policy", "worktree") != "worktree" or _git_root(cwd) is not None
+
+
+def repo_signals(cwd: str, text: str) -> Dict[str, Any]:
+    """Code-known signals for the activity class: is there a checkout, are named paths present."""
+    root = _git_root(cwd)
+    named = [m for m in _PATHISH.findall(text or "")[:20]]
+    existing = sum(1 for m in named if (Path(cwd) / m).exists())
+    return {"cwd_is_git_checkout": root is not None, "paths_named": len(named), "paths_existing": existing}
+
+
+# Model lanes an executor's own CLI accepts by alias. Only executors listed here get a lane
+# decision; for any other type the executor's default model runs (no guessed model ids).
+EXECUTOR_LANES = {
+    "claude-code": (("haiku", "Mechanical, fully specified small work: a rename, a one-line fix, a lookup."),
+                    ("sonnet", "Ordinary work with a clear goal: a feature or fix in a few files, tests."),
+                    ("opus", "Hard work: many files, an unknown cause, design choices or an expensive mistake.")),
+}
+
+
+def lane_model(agent, entry: Dict[str, Any], *, brief: str, session_id: str, turn_id: str) -> Optional[str]:
+    """The executor model: an explicit ``model`` pin wins; else a Jev lane among the executor's own
+    aliases; anything unusable is None (the executor's default model)."""
+    if entry.get("model"):
+        return entry["model"]
+    lanes = EXECUTOR_LANES.get(entry.get("type"))
+    if not lanes:
+        return None
+    from agent import decision_seams as seams
+    picked: Dict[str, str] = {}
+    outcome = seams.decide(agent, [seams.Request(
+        point="work.executor", step="work.executor.lane", revision=turn_id,
+        candidates=[{"description": text, "model": alias} for alias, text in lanes],
+        state={"task": brief}, execute=lambda v: picked.__setitem__("model", v["model"]),
+        validate=lambda v: v.get("model") in dict(lanes))], session_id=session_id, turn_id=turn_id,
+        payload=brief)[0]
+    return picked.get("model") if outcome.applied else None
+
+
+def _cleanup(root: str, workdir: str, branch: str) -> str:
+    """After the result is captured: drop a worktree the executor left clean (its commits stay on
+    the branch). A worktree holding uncommitted changes is kept for the person, never deleted."""
+    status = subprocess.run(["git", "-C", workdir, "status", "--porcelain"], capture_output=True, text=True, timeout=30)
+    if status.returncode != 0 or status.stdout.strip():
+        return "kept"
+    subprocess.run(["git", "-C", root, "worktree", "remove", workdir], capture_output=True, timeout=60)
+    # Safe delete only: a branch the executor committed to survives (-d refuses unmerged work).
+    subprocess.run(["git", "-C", root, "branch", "-d", branch], capture_output=True, timeout=30)
+    return "removed"
+
+
+def run(agent, entry: Dict[str, Any], *, brief: str, activity: str, model: Optional[str] = None) -> Dict[str, Any]:
+    """Run one bounded executor job and return its report (raises on a host-side failure)."""
+    program = _program(entry)
+    if program is None:
+        raise RuntimeError("executor_unready")
+    cwd = getattr(agent, "session_cwd", None) or os.getcwd()
+    workdir, branch, root = cwd, None, None
+    if entry.get("workdir_policy", "worktree") == "worktree":
+        root = _git_root(cwd)
+        if root is None:
+            raise RuntimeError("executor_unready")
+        branch = f"hermes-exec/{activity}-{uuid.uuid4().hex[:8]}"
+        root = str(root)
+        workdir = tempfile.mkdtemp(prefix="hermes-exec-")
+        subprocess.run(["git", "-C", root, "worktree", "add", "-b", branch, workdir], check=True,
+                       capture_output=True, timeout=60)
+    text = f"{brief}\n\n(Work only inside {workdir}. Summarize what you changed at the end.)"
+    if entry.get("type") == "command":
+        argv, stdin = program, text
+    else:
+        argv, stdin = program + _ARGV[entry["type"]][1](text, model or entry.get("model")), None
+    done = subprocess.run(argv, cwd=workdir, input=stdin, capture_output=True, text=True,
+                          timeout=TIMEOUT_SECONDS)
+    report = {"executor": entry.get("type"), "activity": activity, "workdir": workdir, "branch": branch,
+              "model": model or entry.get("model"), "exit_code": done.returncode,
+              "output": (done.stdout or "")[-MAX_FEEDBACK:],
+              "errors": (done.stderr or "")[-1000:] if done.returncode else ""}
+    if branch:
+        report["worktree"] = _cleanup(root, workdir, branch)
+    return report
+
+
+def feedback(report: Dict[str, Any]) -> str:
+    """The turn's reply: where the work happened and what the executor said."""
+    head = (f"[{report['executor']} ran this as `{report['activity']}` work in {report['workdir']}"
+            + (f" on branch {report['branch']} (worktree {report.get('worktree', 'kept')})" if report.get("branch") else "")
+            + (f" with model {report['model']}" if report.get("model") else "")
+            + f"; exit code {report['exit_code']}.]")
+    body = report.get("output") or "(no output)"
+    tail = f"\n\nErrors:\n{report['errors']}" if report.get("errors") else ""
+    return f"{head}\n\n{body}{tail}"
